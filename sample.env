# APP ENVS
APP_PORT=8000
APP_DEBUG=
APP_SECRET_KEY=
# The keys the links in emails (tickets, certificates, feedback surveys) are
# signed with: comma-separated, the first signs and every one verifies, each at
# least 32 characters (openssl rand -hex 32). Unset: APP_SECRET_KEY signs them.
# Rotation (add the new key first, drop the old after 90 days, never list a
# leaked one): docs/OPERATIONS.md, section 5.
# APP_LINK_SIGNING_KEYS=
APP_DATABASE_URL=postgresql+asyncpg://aswanth:password@192.168.1.101:5432/doth
APP_DATABASE_URL_SYNC=postgresql://aswanth:password@192.168.1.101:5432/doth
APP_CORS_ORIGINS=*
APP_APP_VERSION=1.0.0

# POSTGRES
POSTGRES_USER=aswanth
POSTGRES_PASSWORD=password
POSTGRES_DB=doth
# SEARCH (optional): unset, every search is Postgres's. Set all three to use the
# meilisearch service in docker-compose.prod.yml: start it once
# (up -d --build --no-deps meilisearch), then recreate the backend with a build
# (up -d --build --no-deps backend worker; docs/OPERATIONS.md, section 6).
# MEILI_MASTER_KEY=
# APP_SEARCH_URL=http://meilisearch:7700
# APP_SEARCH_KEY=

# DOCUMENTS (tickets, certificates, ID cards)
# Artwork, logos, signatures and pictures uploaded for a printed design are
# stored with their longest side at most this many pixels, as a JPEG or (with
# transparency) a PNG, upright and without metadata. 2400 is about 200 dpi
# across an A4 certificate. Existing artwork: scripts/optimize_doc_art.py.
# APP_DOC_ART_MAX_PX=2400
# A document nobody has kept yet is drawn by one process; the others asking
# for it at the same moment wait for it this many seconds at most, then draw
# it themselves.
# APP_DOC_RENDER_WAIT_SECONDS=20
# Kept documents (docs/ in the bucket) last written more than this many days
# ago are deleted once a day; the next download draws them again. 0 or unset:
# never. Not together with a bucket lifecycle rule on docs/ with another day
# count (docs/OPERATIONS.md, section 13). Check first: scripts/doc_cache_report.py.
# APP_DOC_CACHE_DAYS=0
# At most this many deleted in one day's run.
# APP_DOC_CACHE_MAX_DELETE_PER_RUN=50000
# An admin alert when more than this percentage of docs/ is not kept documents.
# APP_DOC_CACHE_SKIP_ALERT_PERCENT=5
# AI assist (docs/OPERATIONS.md section 14). Off until APP_AI_ENABLED=true.
# One Gemini key on a PAID project; never a list of keys.
# APP_AI_ENABLED=false
# APP_GEMINI_API_KEY=
# APP_AI_MODELS=gemini-3.8-flash,gemini-3.5-flash-lite
# APP_AI_VISION_MODELS=gemini-3.8-flash,gemini-3.5-flash-lite
# Fernet key for clubs' own AI keys: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# APP_AI_KEYS_SECRET=

# A CLUB'S OWN WHATSAPP NUMBER (Enterprise; docs/OPERATIONS.md section 21)
# Fernet key for clubs' WhatsApp tokens and app secrets (its own, not the
# payment or AI one). Unset: no club can connect a number.
# APP_WHATSAPP_KEYS_SECRET=
# APP_CLUB_WHATSAPP_QUALITY_HOURS=6
# APP_CLUB_WHATSAPP_MEDIA_MAX_MB=25
# A club's broadcasts go at this many messages a second (Meta allows 80).
# APP_CLUB_WHATSAPP_BROADCAST_MPS=10
# "Connect with Meta" (Embedded Signup), once MyOtherApp is a Meta Tech
# Provider: off until then (docs/OPERATIONS.md section 21, "Turning on
# one-click connect"). The platform app's id and secret, the Facebook Login
# for Business configuration's id, and the verify token of the app's default
# webhook URL (https://api.myotherapp.in/api/v1/hooks/whatsapp).
# APP_WHATSAPP_EMBEDDED_SIGNUP=false
# APP_META_APP_ID=
# APP_META_APP_SECRET=
# APP_META_ES_CONFIG_ID=
# APP_META_WEBHOOK_VERIFY_TOKEN=

# AI ASSISTANTS OVER MCP (docs/MCP.md)
# The kill switch: off, /mcp, /oauth/* and their discovery documents answer
# 404 and nothing an assistant asked for can be approved.
# APP_MCP_ENABLED=false
# The club dashboard, for the links the tools hand back (/confirm/{token}, /events/{id}).
# APP_MCP_DASHBOARD_URL=https://club-dashboard.myotherapp.in
# APP_MCP_ACCESS_TOKEN_MINUTES=60
# APP_MCP_REFRESH_TOKEN_DAYS=30
# Calls one connected app may make.
# APP_MCP_RATE_LIMIT=60/minute;2000/day
# Browser pages allowed to call /mcp directly (requests with no Origin are always fine).
# APP_MCP_ALLOWED_ORIGINS=https://claude.ai,https://chatgpt.com,https://chat.openai.com
# Clients known by an https URL to their metadata document (fetched once, cached).
# APP_MCP_CLIENT_METADATA_DOCUMENTS=true
