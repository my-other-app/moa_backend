# APP ENVS
APP_PORT=8000
APP_DEBUG=
APP_SECRET_KEY=
# The keys the links in emails (tickets, certificates, feedback surveys) are
# signed with: comma-separated, the first signs and every one verifies, each at
# least 32 characters (openssl rand -hex 32). Unset: APP_SECRET_KEY signs them.
# Rotation (add the new key first, drop the old after 90 days, never list a
# leaked one): docs/OPERATIONS.md, section 5.
# APP_LINK_SIGNING_KEYS=
APP_DATABASE_URL=postgresql+asyncpg://aswanth:password@192.168.1.101:5432/doth
APP_DATABASE_URL_SYNC=postgresql://aswanth:password@192.168.1.101:5432/doth
APP_CORS_ORIGINS=*
APP_APP_VERSION=1.0.0

# POSTGRES
POSTGRES_USER=aswanth
POSTGRES_PASSWORD=password
POSTGRES_DB=doth
# SEARCH (optional): unset, every search is Postgres's. Set all three to use the
# meilisearch service in docker-compose.prod.yml: start it once
# (up -d --build --no-deps meilisearch), then recreate the backend with a build
# (up -d --build --no-deps backend worker; docs/OPERATIONS.md, section 6).
# MEILI_MASTER_KEY=
# APP_SEARCH_URL=http://meilisearch:7700
# APP_SEARCH_KEY=

# DOCUMENTS (tickets, certificates, ID cards)
# Artwork, logos, signatures and pictures uploaded for a printed design are
# stored with their longest side at most this many pixels, as a JPEG or (with
# transparency) a PNG, upright and without metadata. 2400 is about 200 dpi
# across an A4 certificate. Existing artwork: scripts/optimize_doc_art.py.
# APP_DOC_ART_MAX_PX=2400
