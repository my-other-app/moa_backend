<section id="{{ section.anchor }}"><h2>{{ section.title }}</h2><p>{{ join_text }}</p>
{% if images["join.image"] %}<img src="{{ images['join.image'].url }}" alt="{{ images['join.image'].alt }}" width="{{ images['join.image'].w }}" height="{{ images['join.image'].h }}" loading="lazy">{% endif %}
<a href="{{ links.join_url }}" target="_top" style="background: var(--accent)">Follow in the app</a></section>
