{
  "key": "fixture",
  "name": "Fixture",
  "blurb": "The tests' stand-in for a designer's template",
  "fonts": ["Inter:wght@400;600"],
  "layout": "single",
  "fixed_top": ["nav", "hero"],
  "fixed_side": [],
  "fixed_bottom": ["footer"],
  "sections": [
    {"key": "upcoming", "label": "Events", "default_title": "Upcoming events", "hideable": true, "anchor": "events"},
    {"key": "about", "label": "About", "default_title": "About us", "hideable": false},
    {"key": "expertise", "label": "Topics", "default_title": "What we do", "hideable": true},
    {"key": "stats", "label": "Numbers", "default_title": "In numbers", "hideable": true},
    {"key": "past", "label": "Past", "default_title": "Past events", "hideable": true},
    {"key": "photos", "label": "Photos", "default_title": "Photos", "hideable": true},
    {"key": "speakers", "label": "Speakers", "default_title": "Speakers", "hideable": true},
    {"key": "team", "label": "Team", "default_title": "The team", "hideable": true},
    {"key": "sponsors", "label": "Sponsors", "default_title": "Partners", "hideable": true, "anchor": "partners"},
    {"key": "join", "label": "Join", "default_title": "Join us", "hideable": true}
  ],
  "slots": [
    {"key": "hero.cover", "label": "Cover photo", "size": [1440, 300], "section": "hero"},
    {"key": "about.image", "label": "About photo", "size": [560, 420], "section": "about"},
    {"key": "photos.1", "label": "Photo 1", "size": [480, 320], "section": "photos"},
    {"key": "photos.2", "label": "Photo 2", "size": [480, 320], "section": "photos"},
    {"key": "photos.3", "label": "Photo 3", "size": [480, 320], "section": "photos"},
    {"key": "join.image", "label": "Join photo", "size": [600, 400], "section": "join"},
    {"key": "event.fallback", "label": "Event without a poster", "size": [400, 500], "section": "upcoming"}
  ],
  "accent": {"default": "#2B4BFF", "vars": ["--accent"]}
}
