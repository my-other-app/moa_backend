{%- macro isrc(h) -%}{%- set l = (h or '')|string|trim -%}{{ l if (l[:8]|lower == 'https://' or l[:7]|lower == 'file://' or l[:11]|lower == 'data:image/') else '' }}{%- endmacro -%}
{%- macro u(h) -%}{%- set l = (h or '')|string|trim -%}{{ l if (l[:8]|lower == 'https://' or l[:7]|lower == 'mailto:' or l[:4]|lower == 'tel:' or l[:1] == '#') else '#' }}{%- endmacro -%}
{%- macro n(v) -%}{%- if v is number -%}{{ ('[' ~ '{:,}'.format(v) ~ ']') if sample else '{:,}'.format(v) }}{%- else -%}{{ v }}{%- endif -%}{%- endmacro -%}
{%- macro iso(v) -%}{{ (v if v is string else v.isoformat()) if v else '' }}{%- endmacro -%}
{%- set t = section.title if (section is defined and section.title) else 'Previous speakers' -%}
{%- if speakers -%}
<section id="speakers" class="tl-sec" style="max-width: 1200px; margin: 0 auto; padding: 72px 24px; display: flex; flex-direction: column; gap: 24px">
<div style="display: flex; flex-wrap: wrap; align-items: baseline; justify-content: space-between; gap: 12px"><h2 style="margin: 0; font-weight: 800; font-size: clamp(28px, 3.4vw, 40px); letter-spacing: -0.03em">{{ t }}</h2>{% if links.speakers_url %}<a href="{{ u(links.speakers_url) }}" target="_top" style="font-weight: 700; padding: 12px 0">All{% if stats.speakers %} {{ n(stats.speakers) }}{% endif %} →</a>{% endif %}</div>
<div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(min(340px, 100%), 1fr)); gap: 16px">
{% for s in speakers %}{% set ph = s.photo.url if s.photo is mapping else s.photo %}{% set role = [s.title, s.org]|select|join(', ') %}{% set when = [s.date, s.event]|select|join(' · ') %}<article style="background: #FFFFFF; border: 1px solid #CBD6D5; border-radius: 16px; padding: 16px; display: flex; gap: 16px; align-items: center">{% if ph %}<img src="{{ isrc(ph) }}"{% if s.photo is mapping and s.photo.srcset %} srcset="{{ s.photo.srcset }}" sizes="76px"{% endif %} width="76" height="76" alt="{{ s.name }}" loading="lazy" decoding="async" style="width: 76px; height: 76px; border-radius: 999px; object-fit: cover; flex: none">{% elif s.photo and s.photo.placeholder is defined %}<span style="width: 76px; height: 76px; border-radius: 999px; background: var(--accent-soft); flex: none"></span>{% else %}<span style="width: 76px; height: 76px; border-radius: 999px; background: var(--accent-soft); flex: none; display: flex; align-items: center; justify-content: center; font-weight: 800; font-size: 22px; color: var(--accent-ink)">{% for w in (s.name or '').split()[:2] %}{{ w[:1]|upper }}{% endfor %}</span>{% endif %}<div style="display: flex; flex-direction: column; min-width: 0"><h3 style="margin: 0; font-weight: 700; font-size: 18px">{{ s.name }}</h3>{% if role %}<span style="font-size: 14px; color: #4F6160">{{ role }}</span>{% endif %}{% if s.talk %}<span style="font-size: 15px">{{ s.talk }}</span>{% endif %}{% if when %}<span style="font-size: 13px; font-weight: 700; color: var(--accent-ink)">{{ when }}</span>{% endif %}</div></article>
{% endfor %}</div>
</section>
{%- endif -%}
