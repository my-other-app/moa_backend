{%- macro u(h) -%}{%- set l = (h or '')|string|trim -%}{{ l if (l[:8]|lower == 'https://' or l[:7]|lower == 'mailto:' or l[:4]|lower == 'tel:' or l[:1] == '#') else '#' }}{%- endmacro -%}
{%- macro n(v) -%}{%- if v is number -%}{{ ('[' ~ '{:,}'.format(v) ~ ']') if sample else '{:,}'.format(v) }}{%- else -%}{{ v }}{%- endif -%}{%- endmacro -%}
{%- macro iso(v) -%}{{ (v if v is string else v.isoformat()) if v else '' }}{%- endmacro -%}
{%- set has_members = stats.members is defined and stats.members is not none -%}
{%- set nums = [(stats.members if has_members else stats.followers, 'Members' if has_members else 'Followers'), (stats.events_held, 'Events hosted'), (stats.speakers, 'Speakers on stage'), (stats.sponsors, 'Sponsors and partners')]|selectattr(0)|list -%}
{%- if nums -%}
<section id="stats" class="tl-stats" style="max-width: 1200px; margin: 0 auto; padding: 0 24px 72px">
<div class="tl-stats-g" style="display: grid; grid-template-columns: repeat(auto-fit, minmax(min(200px, 100%), 1fr)); gap: 16px">
{% for v, label in nums %}<div style="background: #FFFFFF; border: 1px solid #CBD6D5; border-radius: 16px; padding: 22px"><div style="font-weight: 800; font-size: 38px; line-height: 1.1; letter-spacing: -0.03em">{{ n(v) }}</div><div style="color: #4F6160; font-size: 15px">{{ label }}</div></div>
{% endfor %}</div>
</section>
{%- endif -%}
