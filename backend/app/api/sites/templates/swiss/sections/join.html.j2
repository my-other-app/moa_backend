{%- macro u(h) -%}{%- set l = (h or '')|string|trim -%}{{ l if (l[:8]|lower == 'https://' or l[:7]|lower == 'mailto:' or l[:4]|lower == 'tel:' or l[:1] == '#') else '#' }}{%- endmacro -%}
{%- set tt = (section.title if (section is defined and section.title) else 'Come to the next one.')|trim|replace('\n', ' ') -%}
{%- if links.join_url -%}
<section id="join" style="display: flex; flex-wrap: wrap; align-items: flex-end; justify-content: space-between; gap: 32px; padding: 72px 0; border-top: 1px solid #0A0A0A">
<h2 style="flex: 2 1 420px; margin: 0; font-weight: 600; font-size: clamp(40px, 7vw, 104px); line-height: 0.95; letter-spacing: -0.045em">{{ tt[:-1] if tt[-1:] == '.' else tt }}<span style="color: var(--accent)">.</span></h2>
<div style="flex: 1 1 340px; display: flex; flex-direction: column; gap: 8px">
<a class="sw-btn" href="{{ u(links.join_url) }}" target="_top" style="min-height: 52px; border: none; background: var(--accent); color: var(--on-accent); font: 500 16px 'Inter Tight', system-ui, sans-serif; cursor: pointer; text-decoration: none">Join community, free</a>
</div>
</section>
{%- endif -%}
