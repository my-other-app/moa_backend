{%- macro isrc(h) -%}{%- set l = (h or '')|string|trim -%}{{ l if (l[:8]|lower == 'https://' or l[:7]|lower == 'file://' or l[:11]|lower == 'data:image/') else '' }}{%- endmacro -%}
{%- macro u(h) -%}{%- set l = (h or '')|string|trim -%}{{ l if (l[:8]|lower == 'https://' or l[:7]|lower == 'mailto:' or l[:4]|lower == 'tel:' or l[:1] == '#') else '#' }}{%- endmacro -%}
{%- macro n(v) -%}{%- if v is number -%}{{ ('[' ~ '{:,}'.format(v) ~ ']') if sample else '{:,}'.format(v) }}{%- else -%}{{ v }}{%- endif -%}{%- endmacro -%}
{%- set t = section.title if (section is defined and section.title) else 'Highlights' -%}
{%- set photos = (images.photos or [])|select|list -%}
{%- if photos -%}
<section id="photos" class="sw-sec" style="display: flex; flex-wrap: wrap; gap: 24px 32px; padding: 40px 0; border-top: 1px solid #0A0A0A">
<div style="flex: 1 1 220px; display: flex; flex-direction: column; gap: 8px"><h2 class="sw-n" style="margin: 0; font-family: 'IBM Plex Mono', ui-monospace, monospace; font-weight: 500; font-size: 13px">{{ t }}</h2>{% if links.gallery_url %}<a href="{{ u(links.gallery_url) }}" target="_top" style="font-family: 'IBM Plex Mono', ui-monospace, monospace; font-size: 13px; padding: 10px 0">Gallery{% if stats.photos %}, {{ n(stats.photos) }}{% endif %} ↗</a>{% endif %}</div>
<div class="sw-photos" style="flex: 4 1 560px; min-width: 0; display: grid; grid-template-columns: repeat(auto-fit, minmax(min(220px, 100%), 1fr)); gap: 8px">
{% for ph in photos %}{% set cap = ph.caption or ph.alt %}<figure style="margin: 0; display: flex; flex-direction: column; gap: 6px">{% if ph.url %}<img class="sw-img" src="{{ isrc(ph.url) }}"{% if ph.srcset %} srcset="{{ ph.srcset }}" sizes="(min-width: 1320px) 300px, (min-width: 760px) 30vw, calc(100vw - 64px)"{% endif %} width="{{ ph.w or 600 }}" height="{{ ph.h or 600 }}" alt="{{ ph.alt or '' }}" loading="lazy" decoding="async" style="aspect-ratio: 1 / 1; height: auto">{% else %}<div style="aspect-ratio: 1 / 1; background: repeating-linear-gradient(135deg, #EAEAEA 0 14px, #F3F3F3 14px 28px)"></div>{% endif %}<figcaption style="font-family: 'IBM Plex Mono', ui-monospace, monospace; font-size: 12px; color: #5C5C5C">Fig. {{ loop.index }}{% if cap %} — {{ cap }}{% endif %}</figcaption></figure>
{% endfor %}</div>
</section>
{%- endif -%}
