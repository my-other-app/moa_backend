{%- macro isrc(h) -%}{%- set l = (h or '')|string|trim -%}{{ l if (l[:8]|lower == 'https://' or l[:7]|lower == 'file://' or l[:11]|lower == 'data:image/') else '' }}{%- endmacro -%}
{%- macro u(h) -%}{%- set l = (h or '')|string|trim -%}{{ l if (l[:8]|lower == 'https://' or l[:7]|lower == 'mailto:' or l[:4]|lower == 'tel:' or l[:1] == '#') else '#' }}{%- endmacro -%}
{%- set t = section.title if (section is defined and section.title) else 'Sponsors, partners' -%}
{%- set main = [] -%}{%- set others = [] -%}
{%- for p in sponsors or [] -%}{%- set _ = (main if ((p.kind == 'sponsor') if p.kind else ('sponsor' in (p.role or '')|lower)) else others).append(p) -%}{%- endfor -%}
{%- if main or others -%}
<section id="sponsors" class="sw-sec" style="display: flex; flex-wrap: wrap; gap: 24px 32px; padding: 40px 0; border-top: 1px solid #0A0A0A">
<h2 class="sw-n" style="flex: 1 1 220px; margin: 0; font-family: 'IBM Plex Mono', ui-monospace, monospace; font-weight: 500; font-size: 13px">{{ t }}</h2>
<div style="flex: 4 1 560px; min-width: 0; display: flex; flex-direction: column; gap: 20px">
{% if main %}<div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(min(180px, 100%), 1fr)); gap: 8px">
{% for p in main %}{% set lg = p.logo.url if p.logo is mapping else p.logo %}<div style="min-height: 100px; border: 1px solid #0A0A0A; display: flex; align-items: center; justify-content: center; font-family: 'IBM Plex Mono', ui-monospace, monospace; font-size: 13px">{% if lg %}<img class="sw-logo" src="{{ isrc(lg) }}" width="160" height="56" alt="{{ p.name }}" loading="lazy" decoding="async">{% else %}{{ p.name }}{% endif %}</div>
{% endfor %}</div>
{% endif %}{% if others %}<div style="display: flex; flex-direction: column">
{% for p in others %}<div style="display: flex; justify-content: space-between; gap: 16px; padding: 12px 0; border-top: 1px solid #D4D4D4{% if loop.last %}; border-bottom: 1px solid #D4D4D4{% endif %}"><span>{{ p.name }}</span>{% if p.role %}<span style="font-family: 'IBM Plex Mono', ui-monospace, monospace; font-size: 13px; color: #5C5C5C">{{ p.role }}</span>{% endif %}</div>
{% endfor %}</div>
{% endif %}</div>
</section>
{%- endif -%}
