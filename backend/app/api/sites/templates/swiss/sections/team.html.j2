{%- macro isrc(h) -%}{%- set l = (h or '')|string|trim -%}{{ l if (l[:8]|lower == 'https://' or l[:7]|lower == 'file://' or l[:11]|lower == 'data:image/') else '' }}{%- endmacro -%}
{%- macro u(h) -%}{%- set l = (h or '')|string|trim -%}{{ l if (l[:8]|lower == 'https://' or l[:7]|lower == 'mailto:' or l[:4]|lower == 'tel:' or l[:1] == '#') else '#' }}{%- endmacro -%}
{%- set t = section.title if (section is defined and section.title) else 'Team' -%}
{%- if team -%}
<section id="team" class="sw-sec" style="display: flex; flex-wrap: wrap; gap: 24px 32px; padding: 40px 0; border-top: 1px solid #0A0A0A">
<h2 class="sw-n" style="flex: 1 1 220px; margin: 0; font-family: 'IBM Plex Mono', ui-monospace, monospace; font-weight: 500; font-size: 13px">{{ t }}</h2>
<div style="flex: 4 1 560px; min-width: 0; display: grid; grid-template-columns: repeat(auto-fit, minmax(min(150px, 100%), 1fr)); gap: 24px 8px">
{% for m in team %}{% set ph = m.photo.url if m.photo is mapping else m.photo %}{% set ss = m.photo.srcset if m.photo is mapping else m.photo_srcset %}<div style="display: flex; flex-direction: column; gap: 4px">{% if ph %}<img class="sw-img" src="{{ isrc(ph) }}"{% if ss %} srcset="{{ ss }}" sizes="(min-width: 1320px) 150px, (min-width: 760px) 18vw, calc(50vw - 40px)"{% endif %} width="400" height="500" alt="{{ m.name }}" loading="lazy" decoding="async" style="aspect-ratio: 4 / 5; height: auto; margin-bottom: 6px">{% elif m.photo and m.photo.placeholder is defined %}<div style="aspect-ratio: 4 / 5; background: repeating-linear-gradient(135deg, #EAEAEA 0 14px, #F3F3F3 14px 28px); margin-bottom: 6px"></div>{% else %}<div style="aspect-ratio: 4 / 5; background: #F3F3F3; margin-bottom: 6px; display: flex; align-items: center; justify-content: center; font-family: 'IBM Plex Mono', ui-monospace, monospace; font-size: 28px; color: #5C5C5C">{% for w in (m.name or '').split()[:2] %}{{ w[:1]|upper }}{% endfor %}</div>{% endif %}<span style="font-weight: 500">{{ m.name }}</span>{% if m.role %}<span style="font-family: 'IBM Plex Mono', ui-monospace, monospace; font-size: 12px; color: #5C5C5C">{{ m.role }}</span>{% endif %}</div>
{% endfor %}</div>
</section>
{%- endif -%}
