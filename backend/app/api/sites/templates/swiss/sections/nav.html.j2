{%- macro u(h) -%}{%- set l = (h or '')|string|trim -%}{{ l if (l[:8]|lower == 'https://' or l[:7]|lower == 'mailto:' or l[:4]|lower == 'tel:' or l[:1] == '#') else '#' }}{%- endmacro -%}
{%- macro host(h, label) -%}{%- set l = (h or '')|string -%}{{ (l.split('//')[1].split('/')[0]|replace('www.', '')) if l[:8]|lower == 'https://' else (label or l) }}{%- endmacro -%}
{%- set keys = (nav|map(attribute='key')|list) if (nav is defined and nav) else (section_keys or []) -%}
{%- set numbered = keys|reject('equalto', 'join')|list -%}
{%- set overrides = site.title_overrides or {} -%}
{%- set nav_labels = {'about': 'About', 'upcoming': 'Upcoming', 'past': 'Past', 'speakers': 'Speakers', 'team': 'Team', 'sponsors': 'Sponsors'} -%}
{%- set cover = images['hero.cover'] -%}
{%- set initials = (club.name.split()|map('first')|join|upper)[:4] -%}
{%- set soc = [] -%}{%- set web = [] -%}
{%- for s in socials or [] -%}{%- set item = {'kind': (s.kind if s is mapping else (s[0]|lower)), 'label': (s.label if s is mapping else s[0]), 'href': (s.href if s is mapping else s[1])} -%}{%- set _ = (web if item.kind == 'website' else soc).append(item) -%}{%- endfor -%}
{%- set web = (club.website if (club.website and club.website.href) else (web|first)) -%}
<header style="display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 12px; padding: 14px 0; border-bottom: 1px solid #0A0A0A; font-family: 'IBM Plex Mono', ui-monospace, monospace; font-size: 13px">
<a href="#top" style="text-decoration: none; padding: 12px 0; font-weight: 500">{{ initials }} — {{ club.name }}</a>
<nav aria-label="Sections" class="sw-nav" style="display: flex; flex-wrap: wrap; gap: 0 4px">
{% for k in numbered %}{% if k in nav_labels %}
<a href="#{{ k }}" style="padding: 14px 8px; text-decoration: none">{{ '%02d'|format(loop.index) }} {{ overrides[k] or nav_labels[k] }}</a>
{% endif %}{% endfor %}
</nav>
{% if links.join_url %}<a href="{{ '#join' if 'join' in keys else u(links.join_url) }}"{% if 'join' not in keys %} target="_top"{% endif %} style="display: inline-flex; align-items: center; min-height: 44px; padding: 0 18px; background: var(--accent); color: var(--on-accent); text-decoration: none; font-weight: 500">Join ↗</a>{% endif %}
</header>
