{%- macro n(v) -%}{%- if v is number -%}{{ ('[' ~ '{:,}'.format(v) ~ ']') if sample else '{:,}'.format(v) }}{%- else -%}{{ v }}{%- endif -%}{%- endmacro -%}
{%- set t = section.title if (section is defined and section.title) else 'Domains of expertise' -%}
{%- set topics = club.topics or [] -%}
{%- set counts = club.topic_counts or {} -%}
{%- set named = [] -%}{%- for x in topics -%}{%- set nm = x.name if x is mapping else x -%}{%- set _ = named.append({'name': nm, 'sessions': (x.sessions if x is mapping else counts[nm])}) -%}{%- endfor -%}
{%- set counted = named|selectattr('sessions')|list -%}
{%- set top = counted[:4] if counted else named[:4] -%}
{%- set rest = named|reject('in', top)|list -%}
{%- if named -%}
<section id="expertise" class="sw-sec" style="display: flex; flex-wrap: wrap; gap: 24px 32px; padding: 40px 0; border-top: 1px solid #0A0A0A">
<h2 class="sw-n" style="flex: 1 1 220px; margin: 0; font-family: 'IBM Plex Mono', ui-monospace, monospace; font-weight: 500; font-size: 13px">{{ t }}</h2>
<div style="flex: 4 1 560px; min-width: 0; display: flex; flex-direction: column">
{% for x in top %}<div style="display: flex; align-items: baseline; gap: 20px; padding: 12px 0; border-bottom: 1px solid #D4D4D4"><span style="font-family: 'IBM Plex Mono', ui-monospace, monospace; font-size: 13px; color: #5C5C5C; flex: 0 0 32px">{{ 'ABCDEFGH'[loop.index0] }}</span><span class="sw-topic" style="flex: 1; font-size: 26px; letter-spacing: -0.02em; font-weight: 500">{{ x.name }}</span>{% if x.sessions %}<span style="font-family: 'IBM Plex Mono', ui-monospace, monospace; font-size: 13px">{{ n(x.sessions) }} {{ 'session' if x.sessions == 1 else 'sessions' }}</span>{% endif %}</div>
{% endfor %}{% if rest %}<p style="margin: 14px 0 0; font-family: 'IBM Plex Mono', ui-monospace, monospace; font-size: 13px; color: #5C5C5C">Also: {{ rest|map(attribute='name')|map('lower')|join(', ') }}</p>
{% endif %}</div>
</section>
{%- endif -%}
