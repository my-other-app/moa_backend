{%- macro isrc(h) -%}{%- set l = (h or '')|string|trim -%}{{ l if (l[:8]|lower == 'https://' or l[:7]|lower == 'file://' or l[:11]|lower == 'data:image/') else '' }}{%- endmacro -%}
{%- macro u(h) -%}{%- set l = (h or '')|string|trim -%}{{ l if (l[:8]|lower == 'https://' or l[:7]|lower == 'mailto:' or l[:4]|lower == 'tel:' or l[:1] == '#') else '#' }}{%- endmacro -%}
{%- macro n(v) -%}{%- if v is number -%}{{ ('[' ~ '{:,}'.format(v) ~ ']') if sample else '{:,}'.format(v) }}{%- else -%}{{ v }}{%- endif -%}{%- endmacro -%}
{%- macro iso(v) -%}{{ (v if v is string else v.isoformat()) if v else '' }}{%- endmacro -%}
{%- set t = section.title if (section is defined and section.title) else 'Upcoming events' -%}
{%- set fallback = images['event.fallback'] -%}
{%- if upcoming -%}
<section id="upcoming" class="sw-sec" style="display: flex; flex-wrap: wrap; gap: 24px 32px; padding: 40px 0; border-top: 1px solid #0A0A0A">
<h2 class="sw-n" style="flex: 1 1 220px; margin: 0; font-family: 'IBM Plex Mono', ui-monospace, monospace; font-weight: 500; font-size: 13px">{{ t }}</h2>
<div style="flex: 4 1 560px; min-width: 0; display: flex; flex-direction: column">
{% for e in upcoming %}
{%- set s = iso(e.starts_at) -%}
{%- set online = e.is_online if (e.is_online is defined and e.is_online is not none) else ((e.mode or e.where or '')|lower == 'online') -%}
{%- set place = 'Online' if online else e.where -%}
{%- set short = 'Online' if online else ((e.where or '').split(',')[0]|trim or none) -%}
{%- if loop.first -%}
{%- set p = e.poster if (e.poster and (e.poster.url or e.poster.placeholder is defined)) else fallback -%}
{%- set cap = e.capacity if e.capacity else ((e.seats_left + e.going) if (e.seats_left is number and e.going is number) else none) -%}
{%- set end = iso(e.ends_at) -%}
{%- set seats = ((n(e.seats_left) ~ ' of ' ~ n(cap) ~ ' seats left') if cap else (n(e.seats_left) ~ ' seats left')) if (e.seats_left is defined and e.seats_left is not none) else none -%}
<article style="display: flex; flex-wrap: wrap; gap: 20px 32px; padding: 0 0 28px; border-bottom: 1px solid #0A0A0A">
{% if p and p.url %}<div class="sw-feat" style="flex: 1 1 300px; min-height: 240px; position: relative; overflow: hidden"><img src="{{ isrc(p.url) }}"{% if p.srcset %} srcset="{{ p.srcset }}" sizes="(min-width: 1320px) 420px, (min-width: 760px) 40vw, calc(100vw - 64px)"{% endif %} width="{{ p.w or 640 }}" height="{{ p.h or 360 }}" alt="{{ p.alt or e.name }}" loading="lazy" decoding="async" style="position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; display: block"></div>
{% elif p and p.placeholder is defined %}<div class="sw-feat" style="flex: 1 1 300px; min-height: 240px; background: repeating-linear-gradient(135deg, #EAEAEA 0 14px, #F3F3F3 14px 28px); display: flex; align-items: flex-end; padding: 14px; box-sizing: border-box">{% if p and p.placeholder %}<span style="background: #FFFFFF; font-family: 'IBM Plex Mono', ui-monospace, monospace; font-size: 12px; padding: 5px 10px">{{ p.placeholder }}</span>{% endif %}</div>
{% endif %}<div style="flex: 1 1 340px; display: flex; flex-direction: column; gap: 10px">
<span style="font-family: 'IBM Plex Mono', ui-monospace, monospace; font-size: 13px; color: var(--accent); font-weight: 500">NEXT — {{ [s[8:10] ~ '.' ~ s[5:7] ~ '.' ~ s[0:4], (e.weekday or '')|upper, (s[11:16] ~ ('–' ~ end[11:16] if end else '')) if s|length > 11 else '']|select|join(', ') }}</span>
<h3 style="margin: 0; font-size: clamp(26px, 3vw, 38px); line-height: 1.08; letter-spacing: -0.03em; font-weight: 600">{{ e.name }}</h3>
{% set meta = [place, ('In person' if not online else none), seats]|select|list %}{% if meta %}<span style="color: #5C5C5C">{{ meta|join(' · ') }}</span>
{% endif %}<a href="{{ u(e.url) }}" target="_top" style="align-self: flex-start; display: inline-flex; align-items: center; min-height: 48px; padding: 0 24px; background: var(--accent); color: var(--on-accent); text-decoration: none; font-weight: 500; margin-top: 8px">Register ↗</a>
</div>
</article>
{%- else %}
<article style="display: flex; flex-wrap: wrap; align-items: baseline; gap: 6px 24px; padding: 18px 0; border-bottom: 1px solid #D4D4D4"><span style="flex: 0 0 110px; font-family: 'IBM Plex Mono', ui-monospace, monospace; font-size: 13px">{{ s[8:10] }}.{{ s[5:7] }}.{{ s[0:4] }}</span><h3 style="flex: 2 1 300px; margin: 0; font-size: 20px; font-weight: 500; letter-spacing: -0.01em">{{ e.name }}</h3>{% set meta = [short, e.kind]|select|list %}<span style="flex: 1 1 180px; font-family: 'IBM Plex Mono', ui-monospace, monospace; font-size: 13px; color: #5C5C5C">{{ meta|join(' · ') }}</span><a href="{{ u(e.url) }}" target="_top" style="font-weight: 500; padding: 10px 0">Register ↗</a></article>
{%- endif %}
{% endfor %}
</div>
</section>
{%- endif -%}
