{%- macro u(h) -%}{%- set l = (h or '')|string|trim -%}{{ l if (l[:8]|lower == 'https://' or l[:7]|lower == 'mailto:' or l[:4]|lower == 'tel:' or l[:1] == '#') else '#' }}{%- endmacro -%}
{%- macro n(v) -%}{%- if v is number -%}{{ ('[' ~ '{:,}'.format(v) ~ ']') if sample else '{:,}'.format(v) }}{%- else -%}{{ v }}{%- endif -%}{%- endmacro -%}
{%- set t = section.title if (section is defined and section.title) else 'About' -%}
{%- set paras = (club.about or '').split('\n')|map('trim')|select|list -%}
{%- set has_members = stats.members is defined and stats.members is not none -%}
{%- set nums = [(stats.members if has_members else stats.followers, 'Members' if has_members else 'Followers'), (stats.events_held, 'Events hosted'), (stats.speakers, 'Speakers'), (stats.sponsors, 'Sponsors, partners')]|selectattr(0)|list -%}
{%- if paras or nums -%}
<section id="about" class="sw-sec" style="display: flex; flex-wrap: wrap; gap: 24px 32px; padding: 40px 0; border-top: 1px solid #0A0A0A">
<h2 class="sw-n" style="flex: 1 1 220px; margin: 0; font-family: 'IBM Plex Mono', ui-monospace, monospace; font-weight: 500; font-size: 13px">{{ t }}</h2>
<div style="flex: 4 1 560px; min-width: 0; display: flex; flex-direction: column; gap: 28px">
{% for p in paras %}<p style="margin: 0; font-size: clamp(22px, 2.8vw, 34px); line-height: 1.25; letter-spacing: -0.02em; font-weight: 500; max-width: 880px; text-wrap: pretty">{{ p }}</p>
{% endfor %}{% if links.join_url or links.follow_url %}<div style="display: flex; flex-wrap: wrap; gap: 12px">{% if links.join_url %}<a href="{{ u(links.join_url) }}" target="_top" style="display: inline-flex; align-items: center; min-height: 48px; padding: 0 24px; background: #0A0A0A; color: #FFFFFF; text-decoration: none; font-weight: 500">Join community</a>{% endif %}{% if links.follow_url %}<a class="sw-btn" href="{{ u(links.follow_url) }}" target="_top" style="min-height: 48px; padding: 0 24px; background: #FFFFFF; border: 1px solid #0A0A0A; color: #0A0A0A; font: 500 16px 'Inter Tight', system-ui, sans-serif; cursor: pointer; text-decoration: none">Follow</a>{% endif %}</div>{% endif %}
{% if nums %}<div class="sw-stats" style="display: grid; grid-template-columns: repeat(auto-fit, minmax(min(180px, 100%), 1fr)); gap: 24px 32px">
{% for v, label in nums %}<div style="border-top: 1px solid #0A0A0A; padding-top: 10px"><div class="sw-statn" style="font-size: 56px; line-height: 1; letter-spacing: -0.04em; font-weight: 500">{{ n(v) }}</div><div style="font-family: 'IBM Plex Mono', ui-monospace, monospace; font-size: 13px; color: #5C5C5C; margin-top: 8px">{{ label }}</div></div>
{% endfor %}</div>
{% endif %}</div>
</section>
{%- endif -%}
