{%- macro isrc(h) -%}{%- set l = (h or '')|string|trim -%}{{ l if (l[:8]|lower == 'https://' or l[:7]|lower == 'file://' or l[:11]|lower == 'data:image/') else '' }}{%- endmacro -%}
{%- macro u(h) -%}{%- set l = (h or '')|string|trim -%}{{ l if (l[:8]|lower == 'https://' or l[:7]|lower == 'mailto:' or l[:4]|lower == 'tel:' or l[:1] == '#') else '#' }}{%- endmacro -%}
{%- macro n(v) -%}{%- if v is number -%}{{ ('[' ~ '{:,}'.format(v) ~ ']') if sample else '{:,}'.format(v) }}{%- else -%}{{ v }}{%- endif -%}{%- endmacro -%}
{%- set t = section.title if (section is defined and section.title) else 'Previous speakers' -%}
{%- if speakers -%}
<section id="speakers" class="sw-sec" style="display: flex; flex-wrap: wrap; gap: 24px 32px; padding: 40px 0; border-top: 1px solid #0A0A0A">
<div style="flex: 1 1 220px; display: flex; flex-direction: column; gap: 8px"><h2 class="sw-n" style="margin: 0; font-family: 'IBM Plex Mono', ui-monospace, monospace; font-weight: 500; font-size: 13px">{{ t }}</h2>{% if links.speakers_url %}<a href="{{ u(links.speakers_url) }}" target="_top" style="font-family: 'IBM Plex Mono', ui-monospace, monospace; font-size: 13px; padding: 10px 0">All{% if stats.speakers %} {{ n(stats.speakers) }}{% endif %} ↗</a>{% endif %}</div>
<div style="flex: 4 1 560px; min-width: 0; display: flex; flex-direction: column">
{% for s in speakers %}{% set ph = s.photo.url if s.photo is mapping else s.photo %}{% set role = [s.title, s.org]|select|join(', ') %}<article style="display: flex; flex-wrap: wrap; align-items: center; gap: 8px 24px; padding: 12px 0; border-bottom: 1px solid #D4D4D4">{% if ph %}<img src="{{ isrc(ph) }}"{% if s.photo is mapping and s.photo.srcset %} srcset="{{ s.photo.srcset }}" sizes="56px"{% endif %} width="56" height="56" alt="{{ s.name }}" loading="lazy" decoding="async" style="width: 56px; height: 56px; object-fit: cover; flex: none">{% elif s.photo and s.photo.placeholder is defined %}<span style="width: 56px; height: 56px; background: #EAEAEA; flex: none"></span>{% else %}<span style="width: 56px; height: 56px; background: #EAEAEA; flex: none; display: flex; align-items: center; justify-content: center; font-family: 'IBM Plex Mono', ui-monospace, monospace; font-size: 15px; color: #5C5C5C">{% for w in (s.name or '').split()[:2] %}{{ w[:1]|upper }}{% endfor %}</span>{% endif %}<h3 style="flex: 1 1 180px; margin: 0; font-size: 20px; font-weight: 500">{{ s.name }}</h3>{% if role %}<span style="flex: 1 1 200px; color: #5C5C5C">{{ role }}</span>{% endif %}{% if s.talk %}<span style="flex: 2 1 260px">{{ s.talk }}</span>{% endif %}{% if s.event %}<span style="font-family: 'IBM Plex Mono', ui-monospace, monospace; font-size: 13px; color: #5C5C5C">{{ s.event }}</span>{% endif %}</article>
{% endfor %}</div>
</section>
{%- endif -%}
