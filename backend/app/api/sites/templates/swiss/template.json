{
  "key": "swiss",
  "name": "Swiss",
  "blurb": "Numbered sections on a strict grid, mono labels, one green accent",
  "fonts": [
    "IBM+Plex+Mono:wght@400;500",
    "Inter+Tight:wght@400;500;600"
  ],
  "layout": "single",
  "fixed_top": [
    "nav",
    "hero"
  ],
  "fixed_side": [],
  "fixed_bottom": [
    "footer"
  ],
  "sections": [
    {
      "key": "about",
      "label": "About and numbers",
      "default_title": "About",
      "hideable": true
    },
    {
      "key": "expertise",
      "label": "Domains of expertise",
      "default_title": "Domains of expertise",
      "hideable": true
    },
    {
      "key": "upcoming",
      "label": "Upcoming events",
      "default_title": "Upcoming events",
      "hideable": true
    },
    {
      "key": "past",
      "label": "Past events",
      "default_title": "Past events",
      "hideable": true
    },
    {
      "key": "photos",
      "label": "Photos",
      "default_title": "Highlights",
      "hideable": true
    },
    {
      "key": "speakers",
      "label": "Speakers",
      "default_title": "Previous speakers",
      "hideable": true
    },
    {
      "key": "team",
      "label": "Team",
      "default_title": "Team",
      "hideable": true
    },
    {
      "key": "sponsors",
      "label": "Sponsors and partners",
      "default_title": "Sponsors, partners",
      "hideable": true
    },
    {
      "key": "join",
      "label": "Join form",
      "default_title": "Come to the next one.",
      "hideable": true
    }
  ],
  "slots": [
    {
      "key": "hero.cover",
      "label": "Cover photo",
      "size": [
        1256,
        420
      ],
      "section": "hero"
    },
    {
      "key": "photos.1",
      "label": "Photo 1",
      "size": [
        600,
        600
      ],
      "section": "photos"
    },
    {
      "key": "photos.2",
      "label": "Photo 2",
      "size": [
        600,
        600
      ],
      "section": "photos"
    },
    {
      "key": "photos.3",
      "label": "Photo 3",
      "size": [
        600,
        600
      ],
      "section": "photos"
    },
    {
      "key": "photos.4",
      "label": "Photo 4",
      "size": [
        600,
        600
      ],
      "section": "photos"
    },
    {
      "key": "event.fallback",
      "label": "Event banner (events without a poster)",
      "size": [
        840,
        480
      ],
      "section": "upcoming"
    }
  ],
  "accent": {
    "default": "#0A7A3F",
    "vars": [
      "--accent"
    ]
  }
}