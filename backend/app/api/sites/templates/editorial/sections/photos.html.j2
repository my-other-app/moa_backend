{%- import "_shared/macros.html.j2" as m with context -%}
{%- set photos = (images.photos or [])[:4] -%}
{%- set shapes = [("2 1 380px", 460), ("1 1 220px", 320), ("1 1 220px", 400), ("1 1 220px", 260)] -%}
{%- if photos -%}
<section id="photos" style="background: #F2F2F2; padding: 72px 0">
<div style="max-width: 1240px; margin: 0 auto; padding: 0 24px; display: flex; flex-direction: column; gap: 28px">
<div style="display: flex; flex-wrap: wrap; align-items: baseline; justify-content: space-between; gap: 12px">
<h2 style="margin: 0; font-family: 'Playfair Display', Georgia, serif; font-weight: 900; font-size: clamp(34px, 5vw, 56px); line-height: 1">{{ section.title }}</h2>
{% if links.gallery_url %}<a href="{{ links.gallery_url }}" style="font-size: 13px; letter-spacing: 0.14em; text-transform: uppercase; font-weight: 600; padding: 12px 0">Full gallery{% if stats.photos %}, {{ m.num(stats.photos) }} photos{% endif %} →</a>{% endif %}
</div>
<div class="e-essay" style="display: flex; flex-wrap: wrap; gap: 20px; align-items: flex-end">
{% for p in photos %}{% set flex, tall = shapes[loop.index0] %}<figure style="margin: 0; flex: {{ flex }}; display: flex; flex-direction: column; gap: 8px"><div class="{{ m.phc(p) }}" style="min-height: {{ tall }}px; background: repeating-linear-gradient(135deg, #D6D6D6 0 14px, #E2E2E2 14px 28px)">{% if m.real(p) %}{{ m.fill(p, 640, tall, "(max-width: 900px) 100vw, 560px") }}{% endif %}</div>{% if p.alt %}<figcaption style="font-size: 14px; font-style: italic; color: #4A4A4A">{{ loop.index }}. {{ p.alt }}</figcaption>{% endif %}</figure>
{% endfor %}</div>
</div>
</section>
{%- endif -%}
