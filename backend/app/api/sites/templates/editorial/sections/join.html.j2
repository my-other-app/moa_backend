{%- import "_shared/macros.html.j2" as m with context -%}
{%- if links.join_url -%}
<section id="join" class="e-pb e-flush" style="max-width: 1240px; margin: 0 auto; padding: 0 24px 80px">
<div class="e-joinbox" style="border: 1px solid #111111; outline: 4px solid #111111; outline-offset: 6px; margin: 10px; padding: clamp(32px, 6vw, 64px); display: flex; flex-direction: column; align-items: center; gap: 16px; text-align: center">
<h2 style="margin: 0; font-family: 'Playfair Display', Georgia, serif; font-weight: 900; font-size: clamp(32px, 5vw, 60px); line-height: 1.05">{{ section.title }}</h2>
<p style="margin: 0; max-width: 520px; font-size: 17px">Membership is free. You get invitations first, recordings of every talk and a seat at the table.</p>
<form action="{{ links.join_url }}" method="get" target="_top" style="display: flex; flex-wrap: wrap; gap: 10px; justify-content: center; align-items: flex-end">
<div style="display: flex; flex-direction: column; gap: 6px; text-align: left"><label for="ed-email" style="font-size: 13px; font-weight: 600">Email address</label><input id="ed-email" name="email" type="email" autocomplete="email" placeholder="you@example.com" style="min-height: 48px; width: 280px; max-width: 100%; padding: 0 14px; border: 1px solid #111111; font: 400 16px Inter, system-ui, sans-serif; box-sizing: border-box"></div>
<button type="submit" style="min-height: 48px; padding: 0 26px; border: none; background: var(--accent); color: #FFFFFF; font: 600 14px Inter, system-ui, sans-serif; letter-spacing: 0.08em; text-transform: uppercase; cursor: pointer">Join community</button>
</form>
</div>
</section>
{%- endif -%}
