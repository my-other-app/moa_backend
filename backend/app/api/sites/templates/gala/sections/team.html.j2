{%- macro isrc(h) -%}{%- set l = (h or '')|string|trim -%}{{ l if (l[:8]|lower == 'https://' or l[:7]|lower == 'file://' or l[:11]|lower == 'data:image/') else '' }}{%- endmacro -%}
{%- macro u(h) -%}{%- set l = (h or '')|string|trim -%}{{ l if (l[:8]|lower == 'https://' or l[:7]|lower == 'mailto:' or l[:4]|lower == 'tel:' or l[:1] == '#') else '#' }}{%- endmacro -%}
{%- macro n(v) -%}{%- if v is number -%}{{ ('[' ~ '{:,}'.format(v) ~ ']') if sample else '{:,}'.format(v) }}{%- else -%}{{ v }}{%- endif -%}{%- endmacro -%}
{%- macro iso(v) -%}{{ (v if v is string else v.isoformat()) if v else '' }}{%- endmacro -%}
{%- set t = section.title if (section is defined and section.title) else 'The committee' -%}
{%- if team -%}
<section id="team" class="gl-band gl-sec" style="background: #143329; padding: 88px 0">
<div style="max-width: 1200px; margin: 0 auto; padding: 0 24px; display: flex; flex-direction: column; align-items: center; gap: 14px">
<div style="font-size: 14px; letter-spacing: 0.22em; text-transform: uppercase; color: var(--accent)">Team members</div>
<h2 style="margin: 0 0 20px; font-family: 'Cormorant Garamond', Georgia, serif; font-weight: 500; font-size: clamp(36px, 5vw, 60px); line-height: 1.05">{{ t }}</h2>
<div class="gl-team" style="align-self: stretch; display: grid; grid-template-columns: repeat(auto-fit, minmax(min(170px, 100%), 1fr)); gap: 28px">
{% for m in team %}{% set ph = m.photo.url if m.photo is mapping else m.photo %}{% set ss = m.photo.srcset if m.photo is mapping else m.photo_srcset %}<div style="display: flex; flex-direction: column; align-items: center; gap: 4px"><div style="width: 120px; height: 120px; border-radius: 999px; border: 1px solid var(--accent); padding: 6px; box-sizing: border-box; margin-bottom: 8px">{% if ph %}<img src="{{ isrc(ph) }}"{% if ss %} srcset="{{ ss }}" sizes="106px"{% endif %} width="106" height="106" alt="{{ m.name }}" loading="lazy" decoding="async" style="display: block; width: 100%; aspect-ratio: 1 / 1; height: auto; border-radius: 999px; object-fit: cover">{% elif m.photo and m.photo.placeholder is defined %}<div style="width: 100%; aspect-ratio: 1 / 1; border-radius: 999px; background: #1E4337"></div>{% else %}<div style="width: 100%; aspect-ratio: 1 / 1; border-radius: 999px; background: #1E4337; display: flex; align-items: center; justify-content: center; font-family: 'Cormorant Garamond', Georgia, serif; font-size: 34px; color: var(--accent)">{% for w in (m.name or '').split()[:2] %}{{ w[:1]|upper }}{% endfor %}</div>{% endif %}</div><span style="font-family: 'Cormorant Garamond', Georgia, serif; font-size: 24px; line-height: 1.2">{{ m.name }}</span>{% if m.role %}<span style="font-size: 14px; color: #C4CDBF">{{ m.role }}</span>{% endif %}</div>
{% endfor %}</div>
</div>
</section>
{%- endif -%}
