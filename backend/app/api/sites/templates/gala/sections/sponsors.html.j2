{%- macro isrc(h) -%}{%- set l = (h or '')|string|trim -%}{{ l if (l[:8]|lower == 'https://' or l[:7]|lower == 'file://' or l[:11]|lower == 'data:image/') else '' }}{%- endmacro -%}
{%- macro u(h) -%}{%- set l = (h or '')|string|trim -%}{{ l if (l[:8]|lower == 'https://' or l[:7]|lower == 'mailto:' or l[:4]|lower == 'tel:' or l[:1] == '#') else '#' }}{%- endmacro -%}
{%- macro n(v) -%}{%- if v is number -%}{{ ('[' ~ '{:,}'.format(v) ~ ']') if sample else '{:,}'.format(v) }}{%- else -%}{{ v }}{%- endif -%}{%- endmacro -%}
{%- macro iso(v) -%}{{ (v if v is string else v.isoformat()) if v else '' }}{%- endmacro -%}
{%- set t = section.title if (section is defined and section.title) else 'Our patrons' -%}
{%- set main = [] -%}{%- set others = [] -%}
{%- for p in sponsors or [] -%}{%- set _ = (main if ((p.kind == 'sponsor') if p.kind else ('sponsor' in (p.role or '')|lower)) else others).append(p) -%}{%- endfor -%}
{%- set top = main[:3] -%}
{%- set rest = main[3:] + others -%}
{%- if top or rest -%}
<section id="sponsors" class="gl-sec" style="max-width: 1200px; margin: 0 auto; padding: 88px 24px; display: flex; flex-direction: column; align-items: center; gap: 14px">
<div style="font-size: 14px; letter-spacing: 0.22em; text-transform: uppercase; color: var(--accent)">Sponsors and partners</div>
<h2 style="margin: 0 0 20px; font-family: 'Cormorant Garamond', Georgia, serif; font-weight: 500; font-size: clamp(36px, 5vw, 60px); line-height: 1.05">{{ t }}</h2>
{% if top %}<div style="align-self: stretch; display: grid; grid-template-columns: repeat(auto-fit, minmax(min(240px, 100%), 1fr)); gap: 16px">
{% for p in top %}{% set lg = p.logo.url if p.logo is mapping else p.logo %}<div style="min-height: 130px; border: 1px solid var(--accent); display: flex; align-items: center; justify-content: center; color: #C4CDBF">{% if lg %}<img class="gl-logo" src="{{ isrc(lg) }}" width="200" height="72" alt="{{ p.name }}" loading="lazy" decoding="async">{% else %}{{ p.name }}{% endif %}</div>
{% endfor %}</div>
{% endif %}{% if rest %}<div class="gl-small" style="align-self: stretch; display: grid; grid-template-columns: repeat(auto-fit, minmax(min(180px, 100%), 1fr)); gap: 16px">
{% for p in rest %}{% set lg = p.logo.url if p.logo is mapping else p.logo %}<div style="min-height: 90px; border: 1px solid #2E4A40; display: flex; align-items: center; justify-content: center; color: #C4CDBF; font-size: 15px">{% if lg %}<img class="gl-logo" src="{{ isrc(lg) }}" width="160" height="56" alt="{{ p.name }}" loading="lazy" decoding="async" style="max-height: 52px">{% else %}{{ p.name }}{% endif %}</div>
{% endfor %}</div>
{% endif %}</section>
{%- endif -%}
