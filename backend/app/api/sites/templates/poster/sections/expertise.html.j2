{%- import "_shared/macros.html.j2" as m with context -%}
{%- set looks = ["background: #FFE14A; color: #111111", "border: 3px solid #FFFFFF", "background: #FFFFFF; color: #111111", "border: 3px solid #FFFFFF", "border: 3px solid #FFFFFF", "background: #FFE14A; color: #111111"] -%}
{%- if club.topics -%}
<section id="expertise" class="p-bt" style="background: #111111; color: #FFFFFF; padding: 40px 0; border-top: 3px solid #111111">
<div style="max-width: 1280px; margin: 0 auto; padding: 0 24px; display: flex; flex-direction: column; gap: 16px">
<h2 style="margin: 0; font-weight: 700; text-transform: uppercase; font-size: 14px; color: #FFE14A">{{ section.title }}</h2>
<div class="p-chips" style="display: flex; flex-wrap: wrap; gap: 10px 14px; font-family: 'Archivo Black', Impact, sans-serif; font-size: clamp(22px, 3.2vw, 40px); text-transform: uppercase; line-height: 1.1">
{% for t in club.topics %}<span style="padding: 6px 14px; {{ looks[loop.index0 % 6] }}">{{ t }}</span>
{% endfor %}</div>
</div>
</section>
{%- endif -%}
