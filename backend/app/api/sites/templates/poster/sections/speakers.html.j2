{%- import "_shared/macros.html.j2" as m with context -%}
{%- if speakers -%}
{%- set rest = speakers[4:]|map(attribute="name")|list -%}
{%- set more = (stats.speakers - speakers|length) if stats.speakers is number else 0 -%}
<section id="speakers" class="p-bt p-bb" style="background: var(--accent); color: #FFFFFF; border-top: 3px solid #111111; border-bottom: 3px solid #111111; padding: 72px 0">
<div style="max-width: 1280px; margin: 0 auto; padding: 0 24px; display: flex; flex-direction: column; gap: 28px">
<div style="display: flex; flex-wrap: wrap; align-items: flex-end; justify-content: space-between; gap: 12px">
<h2 class="p-h2" style="margin: 0; font-family: 'Archivo Black', Impact, sans-serif; font-weight: 400; font-size: clamp(40px, 7vw, 88px); line-height: 0.9; text-transform: uppercase; letter-spacing: -0.02em">{{ section.title }}</h2>
{% if links.speakers_url and stats.speakers %}<a href="{{ links.speakers_url }}" style="font-weight: 700; text-transform: uppercase; color: #FFFFFF; padding: 12px 0">All {{ m.num(stats.speakers) }} →</a>{% endif %}
</div>
<div class="p-2up-phone" style="display: grid; grid-template-columns: repeat(auto-fit, minmax(min(280px, 100%), 1fr)); gap: 20px">
{% for s in speakers[:4] %}<article style="background: #FFFFFF; color: #111111; border: 3px solid #111111"><div class="{{ m.phc(s.photo) }}" style="aspect-ratio: 4 / 3; border-bottom: 3px solid #111111; background: repeating-linear-gradient(135deg, #FFFFFF 0 14px, #EDEDED 14px 28px)">{% if m.real(s.photo) %}{{ m.fill(s.photo, 300, 225, "(max-width: 600px) 50vw, 300px", alt=s.name) }}{% endif %}</div><div style="padding: 16px; display: flex; flex-direction: column; gap: 4px"><h3 style="margin: 0; font-family: 'Archivo Black', Impact, sans-serif; font-weight: 400; font-size: 22px; text-transform: uppercase">{{ s.name }}</h3>{% if s.title or s.org %}<span style="font-size: 14px">{{ m.role(s) }}</span>{% endif %}{% if s.talk %}<span style="font-weight: 700">{{ s.talk }}</span>{% endif %}</div></article>
{% endfor %}</div>
{% if rest or more > 0 %}<p style="margin: 0; font-weight: 700; font-size: 18px; line-height: 1.6">Also on our stage: {{ (rest + (["and " ~ m.num(more) ~ " more"] if more > 0 else []))|join(" · ") }}</p>{% endif %}
</div>
</section>
{%- endif -%}
