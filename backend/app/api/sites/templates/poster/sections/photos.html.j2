{%- import "macros.html.j2" as m with context -%}
{%- set photos = (images.photos or [])[:4] -%}
{%- if photos -%}
<section id="photos" style="max-width: 1280px; margin: 0 auto; padding: 72px 24px; display: flex; flex-direction: column; gap: 28px">
<div style="display: flex; flex-wrap: wrap; align-items: flex-end; justify-content: space-between; gap: 12px">
<h2 class="p-h2" style="margin: 0; font-family: 'Archivo Black', Impact, sans-serif; font-weight: 400; font-size: clamp(40px, 7vw, 88px); line-height: 0.9; text-transform: uppercase; letter-spacing: -0.02em">{{ section.title }}</h2>
{% if links.gallery_url %}<a href="{{ links.gallery_url }}" target="_top" style="font-weight: 700; text-transform: uppercase; padding: 12px 0">Full gallery →</a>{% endif %}
</div>
<div class="p-photos" style="display: grid; grid-template-columns: repeat(auto-fit, minmax(min(280px, 100%), 1fr)); gap: 20px">
{% for p in photos %}<div class="{{ m.phc(p) }}" style="min-height: 300px; border: 3px solid #111111; box-shadow: 8px 8px 0 {{ '#111111' if loop.index is odd else 'var(--accent)' }}; background: repeating-linear-gradient(135deg, #FFFFFF 0 14px, #EDEDED 14px 28px); display: flex; align-items: flex-end; padding: 14px; box-sizing: border-box">{% if m.real(p) %}{{ m.fill(p, 300, 300, "(max-width: 600px) 100vw, 300px") }}{% elif m.label(p) %}<span style="background: #111111; color: #FFFFFF; font-size: 13px; padding: 5px 10px">{{ m.label(p) }}</span>{% endif %}</div>
{% endfor %}</div>
</section>
{%- endif -%}
