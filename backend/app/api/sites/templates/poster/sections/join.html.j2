{%- import "_shared/macros.html.j2" as m with context -%}
{%- set line = [club.address or club.location_name, club.contact_email]|select|join(" · ") -%}
{%- if links.join_url -%}
<section id="join" style="background: #111111; color: #FFFFFF; padding: 72px 0">
<div style="max-width: 1280px; margin: 0 auto; padding: 0 24px; display: flex; flex-wrap: wrap; align-items: flex-end; justify-content: space-between; gap: 32px">
<h2 class="p-h2" style="flex: 1 1 420px; margin: 0; font-family: 'Archivo Black', Impact, sans-serif; font-weight: 400; font-size: clamp(44px, 8vw, 112px); line-height: 0.88; text-transform: uppercase; color: #FFE14A">{{ section.title }}</h2>
<form action="{{ links.join_url }}" method="get" target="_top" style="flex: 1 1 340px; display: flex; flex-direction: column; gap: 10px">
<label for="ps-email" style="font-weight: 700; text-transform: uppercase; font-size: 14px">Email address</label>
<input id="ps-email" name="email" type="email" autocomplete="email" placeholder="you@example.com" style="min-height: 54px; padding: 0 16px; border: 3px solid #FFFFFF; background: #FFFFFF; color: #111111; font: 500 17px Archivo, system-ui, sans-serif; box-sizing: border-box">
<button type="submit" style="min-height: 54px; border: 3px solid #FFE14A; background: #FFE14A; color: #111111; font: 700 17px Archivo, system-ui, sans-serif; text-transform: uppercase; cursor: pointer">Join community, it is free</button>
{% if line %}<span class="p-wrap" style="font-size: 14px; color: #E0E0E0">{{ line }}</span>{% endif %}
</form>
</div>
</section>
{%- endif -%}
