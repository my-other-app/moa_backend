{%- import "_shared/macros.html.j2" as m with context -%}
{%- if past -%}
<section id="past" class="p-bt p-bb" style="background: #FFFFFF; border-top: 3px solid #111111; border-bottom: 3px solid #111111; padding: 72px 0">
<div style="max-width: 1280px; margin: 0 auto; padding: 0 24px; display: flex; flex-direction: column; gap: 28px">
<div style="display: flex; flex-wrap: wrap; align-items: flex-end; justify-content: space-between; gap: 12px">
<h2 class="p-h2" style="margin: 0; font-family: 'Archivo Black', Impact, sans-serif; font-weight: 400; font-size: clamp(40px, 7vw, 88px); line-height: 0.9; text-transform: uppercase; letter-spacing: -0.02em">{{ section.title }}</h2>
{% if links.events_url %}<a href="{{ links.events_url }}" style="font-weight: 700; text-transform: uppercase; padding: 12px 0">All {% if stats.events_held %}{{ m.num(stats.events_held) }} {% endif %}past events →</a>{% endif %}
</div>
<div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(min(260px, 100%), 1fr)); gap: 20px">
{% for e in past %}{% set pic = e.poster or images["event.fallback"] %}<article style="border: 3px solid #111111; display: flex; flex-direction: column"><div class="{{ m.phc(pic) }}" style="height: 170px; border-bottom: 3px solid #111111; background: repeating-linear-gradient(135deg, #FFFFFF 0 14px, #EDEDED 14px 28px); position: relative">{% if m.real(pic) %}{{ m.fill(pic, 300, 170, "(max-width: 600px) 100vw, 300px", alt=e.name, poster=(pic is sameas e.poster)) }}{% endif %}{% if e.number %}<span style="position: absolute; left: 0; top: 0; background: #111111; color: #FFFFFF; font-family: 'Archivo Black', Impact, sans-serif; font-size: 22px; padding: 4px 12px">#{{ e.number }}</span>{% endif %}</div><div style="padding: 18px; display: flex; flex-direction: column; gap: 6px"><span style="font-weight: 700; text-transform: uppercase; font-size: 13px">{{ [e.day ~ " " ~ e.month ~ " " ~ e.year, e.kind]|select|join(" · ") }}</span><h3 style="margin: 0; font-weight: 700; font-size: 20px; line-height: 1.2">{{ e.name }}</h3>{% if e.facts %}<span style="font-size: 15px">{{ e.facts|join(" · ") }}</span>{% endif %}{% if e.url %}<a href="{{ e.url }}" style="font-weight: 700; text-transform: uppercase; font-size: 14px; padding: 10px 0">Recap →</a>{% endif %}</div></article>
{% endfor %}</div>
</div>
</section>
{%- endif -%}
