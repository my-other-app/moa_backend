{%- import "macros.html.j2" as m with context -%}
{%- set cover = images["hero.cover"] or club.cover -%}
<div id="top" class="{{ m.phc(cover, 'n-cover') }}" style="min-height: 240px; background: repeating-linear-gradient(135deg, #14181D 0 14px, #1B2027 14px 28px); display: flex; align-items: flex-end; justify-content: flex-end; padding: 16px 24px; box-sizing: border-box">{% if m.real(cover) %}{{ m.fill(cover, 1440, 240, "100vw", eager=true, alt=club.name) }}{% elif m.label(cover) %}<span style="background: #0B0D10; color: #C9D1DC; font-size: 13px; padding: 5px 10px; border-radius: 6px">{{ m.label(cover) }}</span>{% endif %}</div>
