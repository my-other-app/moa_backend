{%- import "_shared/macros.html.j2" as m with context -%}
{%- set paras = (club.about or "").split("\n")|map("trim")|select|list -%}
{%- if paras -%}
<section id="about" style="display: flex; flex-direction: column; gap: 12px">
<h2 style="margin: 0; font-family: 'JetBrains Mono', ui-monospace, monospace; font-weight: 500; font-size: 14px; color: var(--accent)">{{ "%02d"|format(section.index) }} / {{ section.title }}</h2>
<p style="margin: 0; font-family: Sora, system-ui, sans-serif; font-weight: 600; font-size: clamp(22px, 2.6vw, 30px); line-height: 1.3; letter-spacing: -0.01em; text-wrap: pretty">{{ paras[0] }}</p>
{% for p in paras[1:] %}<p style="margin: 0; color: #C9D1DC">{{ p }}</p>
{% endfor %}</section>
{%- endif -%}
