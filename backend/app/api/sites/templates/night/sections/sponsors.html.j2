{%- import "macros.html.j2" as m with context -%}
{%- set ns = namespace(b=[], p=[]) -%}
{%- for s in sponsors -%}{%- if "sponsor" in (s.role or "")|lower -%}{%- set ns.b = ns.b + [s] -%}{%- else -%}{%- set ns.p = ns.p + [s] -%}{%- endif -%}{%- endfor -%}
{%- set backers, partners = ns.b, ns.p -%}
{%- if sponsors -%}
<section id="sponsors" style="display: flex; flex-direction: column; gap: 20px">
<h2 style="margin: 0; font-family: Sora, system-ui, sans-serif; font-weight: 700; font-size: 30px">{{ section.title }}</h2>
<div class="n-2up-phone" style="display: grid; grid-template-columns: repeat(auto-fit, minmax(min(180px, 100%), 1fr)); gap: 12px">
{% for s in backers %}<div style="min-height: 96px; border: 1px solid #262C35; border-radius: 16px; display: flex; align-items: center; justify-content: center; color: #9AA4B2; font-size: 14px">{% if m.real(s.logo) %}<img class="logo-img" src="{{ s.logo.url }}"{% if s.logo.srcset %} srcset="{{ s.logo.srcset }}" sizes="140px"{% endif %} width="{{ s.logo.w or 140 }}" height="{{ s.logo.h or 56 }}" alt="{{ s.name }}" loading="lazy" decoding="async" style="max-width: 70%; max-height: 56px">{% else %}{{ s.name }}{% endif %}</div>
{% endfor %}{% for s in partners %}<div style="min-height: 96px; border: 1px dashed #4A5361; border-radius: 16px; display: flex; align-items: center; justify-content: center; color: #9AA4B2; font-size: 14px">{% if m.real(s.logo) %}<img class="logo-img" src="{{ s.logo.url }}"{% if s.logo.srcset %} srcset="{{ s.logo.srcset }}" sizes="140px"{% endif %} width="{{ s.logo.w or 140 }}" height="{{ s.logo.h or 56 }}" alt="{{ s.name }}" loading="lazy" decoding="async" style="max-width: 70%; max-height: 56px">{% else %}{{ s.name }}{% endif %}</div>
{% endfor %}</div>
</section>
{%- endif -%}
