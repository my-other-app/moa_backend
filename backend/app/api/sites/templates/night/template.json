{
  "key": "night",
  "name": "Night",
  "blurb": "Dark, two columns: a profile card beside the club's events and people",
  "fonts": ["Inter:wght@400;500;600", "JetBrains+Mono:wght@500", "Sora:wght@600;700"],
  "layout": "two_column",
  "fixed_top": ["nav", "hero"],
  "fixed_side": ["profile"],
  "fixed_bottom": ["footer"],
  "sections": [
    {"key": "about", "label": "About", "default_title": "about", "hideable": true},
    {"key": "upcoming", "label": "Upcoming events", "default_title": "Upcoming events", "hideable": true},
    {"key": "past", "label": "Past events", "default_title": "Past events", "hideable": true},
    {"key": "photos", "label": "Photos", "default_title": "Highlights", "hideable": true},
    {"key": "speakers", "label": "Speakers", "default_title": "Previous speakers", "hideable": true},
    {"key": "sponsors", "label": "Sponsors and partners", "default_title": "Sponsors and partners", "hideable": true},
    {"key": "join", "label": "Join banner", "default_title": "Come to the next one.", "hideable": true}
  ],
  "slots": [
    {"key": "hero.cover", "label": "Cover photo", "size": [1440, 240], "section": "hero"},
    {"key": "photos.1", "label": "Photo 1", "size": [300, 400], "section": "photos"},
    {"key": "photos.2", "label": "Photo 2", "size": [300, 400], "section": "photos"},
    {"key": "photos.3", "label": "Photo 3", "size": [300, 400], "section": "photos"},
    {"key": "photos.4", "label": "Photo 4", "size": [300, 400], "section": "photos"},
    {"key": "event.fallback", "label": "Event banner (events without a poster)", "size": [360, 260], "section": "upcoming"}
  ],
  "accent": {"default": "#C6F432", "vars": ["--accent"]}
}
