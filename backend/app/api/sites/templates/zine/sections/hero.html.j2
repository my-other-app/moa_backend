{%- macro isrc(h) -%}{%- set l = (h or '')|string|trim -%}{{ l if (l[:8]|lower == 'https://' or l[:7]|lower == 'file://' or l[:11]|lower == 'data:image/') else '' }}{%- endmacro -%}
{%- macro u(h) -%}{%- set l = (h or '')|string|trim -%}{{ l if (l[:8]|lower == 'https://' or l[:7]|lower == 'mailto:' or l[:4]|lower == 'tel:' or l[:1] == '#') else '#' }}{%- endmacro -%}
{%- macro host(h, label) -%}{%- set l = (h or '')|string -%}{{ (l.split('//')[1].split('/')[0]|replace('www.', '')) if l[:8]|lower == 'https://' else (label or l) }}{%- endmacro -%}
{%- set keys = (nav|map(attribute='key')|list) if (nav is defined and nav) else (section_keys or []) -%}
{%- set overrides = site.title_overrides or {} -%}
{%- set nav_labels = {'about': 'about', 'upcoming': 'next', 'past': 'before', 'photos': 'photos', 'speakers': 'speakers', 'team': 'team', 'sponsors': 'friends'} -%}
{%- set items = keys|select('in', nav_labels)|list -%}
{%- set cover = images['hero.cover'] -%}
{%- set lead = site.subline or club.tagline or subline -%}
{%- set join_href = '#join' if 'join' in keys else u(links.join_url) -%}
{%- set mark = (club.name.split()|map('first')|join|upper)[:4] ~ '*' -%}
{%- set soc = [] -%}{%- set web = [] -%}
{%- for s in socials or [] -%}{%- set item = {'kind': (s.kind if s is mapping else (s[0]|lower)), 'label': (s.label if s is mapping else s[0]), 'href': (s.href if s is mapping else s[1])} -%}{%- set _ = (web if item.kind == 'website' else soc).append(item) -%}{%- endfor -%}
{%- if club.website and club.website.href -%}{%- set _ = web.insert(0, {'kind': 'website', 'label': club.website.label, 'href': club.website.href}) -%}{%- endif -%}
{%- set links_row = web[:1] + soc -%}
<section id="top" class="zn-hero" style="max-width: 1240px; margin: 0 auto; padding: 40px 24px 80px; display: flex; flex-wrap: wrap; gap: 40px; align-items: center">
<div style="flex: 3 1 480px; min-width: 0; display: flex; flex-direction: column; gap: 22px; align-items: flex-start">
{% if club.kind %}<span style="padding: 8px 18px; border-radius: 999px; background: var(--accent); color: var(--on-accent); font-weight: 700; transform: rotate(-3deg)">{{ club.kind }}</span>
{% endif %}<h1 style="margin: 0; font-family: Unbounded, system-ui, sans-serif; font-weight: 900; font-size: clamp(40px, 7.4vw, 104px); line-height: 0.98; letter-spacing: -0.03em; overflow-wrap: break-word; max-width: 100%">{{ (site.headline or club.name)|trim|replace('\n', ' ') }}</h1>
{% if lead %}<p style="margin: 0; font-size: 21px; max-width: 560px">{{ lead }}</p>
{% endif %}{% if links.join_url or links.follow_url %}<div style="display: flex; flex-wrap: wrap; gap: 12px">
{% if links.join_url %}<a href="{{ join_href }}"{% if 'join' not in keys %} target="_top"{% endif %} style="display: inline-flex; align-items: center; min-height: 54px; padding: 0 30px; border-radius: 999px; background: #1B2A9E; color: #FFFFFF; text-decoration: none; font-weight: 700; font-size: 18px">Join community</a>
{% endif %}{% if links.follow_url %}<a class="zn-btn" href="{{ u(links.follow_url) }}" target="_top" style="min-height: 54px; padding: 0 28px; border-radius: 999px; background: transparent; border: 2px dashed #1B2A9E; color: #1B2A9E; font: 700 18px 'Space Grotesk', system-ui, sans-serif; cursor: pointer; text-decoration: none">Follow</a>
{% endif %}</div>
{% endif %}{% if links_row %}<div style="display: flex; flex-wrap: wrap; gap: 0 18px; font-weight: 700; font-size: 15px">{% for s in links_row %}<a href="{{ u(s.href) }}" target="_top" style="padding: 10px 0">{{ host(s.href, s.label) if s.kind == 'website' else s.label }}</a>{% endfor %}</div>
{% endif %}</div>
{% if cover and (cover.url or cover.placeholder is defined) %}{% set cap = cover.placeholder if cover.placeholder is defined else (cover.caption or cover.alt) %}<div style="flex: 2 1 340px; display: flex; justify-content: center; padding: 20px 0">
<div class="zn-polaroid" style="width: 100%; max-width: 440px; background: #FFFFFF; padding: 14px 14px 18px; box-shadow: 10px 10px 0 var(--accent); transform: rotate(3deg); display: flex; flex-direction: column; gap: 10px">
{% if cover.url %}<img class="zn-img" src="{{ isrc(cover.url) }}"{% if cover.srcset %} srcset="{{ cover.srcset }}" sizes="(min-width: 640px) 412px, calc(100vw - 76px)"{% endif %} width="{{ cover.w or 412 }}" height="{{ cover.h or 515 }}" alt="{{ cover.alt or '' }}" fetchpriority="high" decoding="async" style="aspect-ratio: 4 / 5; height: auto">{% else %}<div style="aspect-ratio: 4 / 5; background: repeating-linear-gradient(135deg, #D9DCF2 0 14px, #E6E8F7 14px 28px)"></div>{% endif %}
{% if cap %}<span style="font-weight: 700; font-size: 15px">{{ cap }}</span>
{% endif %}</div>
</div>
{% endif %}</section>
