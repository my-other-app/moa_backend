{%- macro isrc(h) -%}{%- set l = (h or '')|string|trim -%}{{ l if (l[:8]|lower == 'https://' or l[:7]|lower == 'file://' or l[:11]|lower == 'data:image/') else '' }}{%- endmacro -%}
{%- macro u(h) -%}{%- set l = (h or '')|string|trim -%}{{ l if (l[:8]|lower == 'https://' or l[:7]|lower == 'mailto:' or l[:4]|lower == 'tel:' or l[:1] == '#') else '#' }}{%- endmacro -%}
{%- macro n(v) -%}{%- if v is number -%}{{ ('[' ~ '{:,}'.format(v) ~ ']') if sample else '{:,}'.format(v) }}{%- else -%}{{ v }}{%- endif -%}{%- endmacro -%}
{%- macro iso(v) -%}{{ (v if v is string else v.isoformat()) if v else '' }}{%- endmacro -%}
{%- set t = section.title if (section is defined and section.title) else 'What came before' -%}
{%- set MON = ['Jan', 'Feb', 'Mar', 'Apr', 'May', 'Jun', 'Jul', 'Aug', 'Sep', 'Oct', 'Nov', 'Dec'] -%}
{%- if past -%}
<section id="past" class="zn-sec" style="max-width: 1240px; margin: 0 auto; padding: 88px 24px; display: flex; flex-direction: column; gap: 32px">
<div style="display: flex; flex-wrap: wrap; align-items: baseline; justify-content: space-between; gap: 12px"><h2 style="margin: 0; font-family: Unbounded, system-ui, sans-serif; font-weight: 900; font-size: clamp(36px, 6vw, 80px); line-height: 1; letter-spacing: -0.03em; overflow-wrap: break-word; max-width: 100%">{{ t }}</h2>{% if links.events_url %}<a href="{{ u(links.events_url) }}" target="_top" style="font-weight: 700; padding: 12px 0">all{% if stats.events_held %} {{ n(stats.events_held) }}{% endif %} past events →</a>{% endif %}</div>
<div style="display: flex; flex-direction: column">
{% for e in past %}{% set s = iso(e.starts_at) %}{% set p = e.poster %}{% set facts = ([(e.day or (s[8:10]|int)) ~ ' ' ~ (e.month or MON[(s[5:7]|int) - 1]) ~ ' ' ~ (e.year or s[0:4]), (e.kind|lower if e.kind else none)] + (e.facts or [(n(e.going) ~ ' attended') if e.going else none, ((e.speakers_count ~ (' speaker' if e.speakers_count == 1 else ' speakers')) if e.speakers_count else none)]))|select|list %}<article style="display: flex; flex-wrap: wrap; align-items: center; gap: 12px 28px; padding: 22px 0; border-top: 2px solid #1B2A9E{% if loop.last %}; border-bottom: 2px solid #1B2A9E{% endif %}"><span class="zn-num" style="flex: 0 0 72px; font-family: Unbounded, system-ui, sans-serif; font-weight: 900; font-size: 30px">{{ ('#' ~ e.number) if e.number else (e.day or (s[8:10]|int)) }}</span><div style="flex: 2 1 320px; min-width: 0"><h3 style="margin: 0; font-weight: 700; font-size: 23px; line-height: 1.2">{{ e.name }}</h3><span style="font-size: 16px">{{ facts|join(' · ') }}</span></div>{% if p and p.url %}<img class="zn-thumb zn-img" src="{{ isrc(p.url) }}"{% if p.srcset %} srcset="{{ p.srcset }}" sizes="150px"{% endif %} width="150" height="92" alt="{{ p.alt or e.name }}" loading="lazy" decoding="async" style="flex: 0 0 150px; width: 150px; height: 92px; border-radius: 14px">{% elif p and p.placeholder is defined %}<div class="zn-thumb" style="flex: 0 0 150px; height: 92px; border-radius: 14px; background: repeating-linear-gradient(135deg, #D9DCF2 0 12px, #E6E8F7 12px 24px)"></div>{% else %}<div class="zn-thumb" style="flex: 0 0 150px; height: 92px; border-radius: 14px; background: #D9DCF2"></div>{% endif %}<a href="{{ u(e.url) }}" target="_top" style="font-weight: 700; padding: 12px 0">recap →</a></article>
{% endfor %}</div>
</section>
{%- endif -%}
