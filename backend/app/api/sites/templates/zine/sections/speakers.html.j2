{%- macro isrc(h) -%}{%- set l = (h or '')|string|trim -%}{{ l if (l[:8]|lower == 'https://' or l[:7]|lower == 'file://' or l[:11]|lower == 'data:image/') else '' }}{%- endmacro -%}
{%- macro u(h) -%}{%- set l = (h or '')|string|trim -%}{{ l if (l[:8]|lower == 'https://' or l[:7]|lower == 'mailto:' or l[:4]|lower == 'tel:' or l[:1] == '#') else '#' }}{%- endmacro -%}
{%- macro n(v) -%}{%- if v is number -%}{{ ('[' ~ '{:,}'.format(v) ~ ']') if sample else '{:,}'.format(v) }}{%- else -%}{{ v }}{%- endif -%}{%- endmacro -%}
{%- macro iso(v) -%}{{ (v if v is string else v.isoformat()) if v else '' }}{%- endmacro -%}
{%- set t = section.title if (section is defined and section.title) else 'Previous speakers' -%}
{%- set shown = (speakers or [])[:4] -%}
{%- set names = (speakers or [])[4:]|map(attribute='name')|list -%}
{%- set others = (stats.speakers - (speakers or [])|length) if stats.speakers is number else 0 -%}
{%- if shown -%}
<section id="speakers" class="zn-sec" style="max-width: 1240px; margin: 0 auto; padding: 88px 24px; display: flex; flex-direction: column; gap: 32px">
<div style="display: flex; flex-wrap: wrap; align-items: baseline; justify-content: space-between; gap: 12px"><h2 style="margin: 0; font-family: Unbounded, system-ui, sans-serif; font-weight: 900; font-size: clamp(36px, 6vw, 80px); line-height: 1; letter-spacing: -0.03em; overflow-wrap: break-word; max-width: 100%">{{ t }}</h2>{% if links.speakers_url %}<a href="{{ u(links.speakers_url) }}" target="_top" style="font-weight: 700; padding: 12px 0">all{% if stats.speakers %} {{ n(stats.speakers) }}{% endif %} →</a>{% endif %}</div>
<div class="zn-spk" style="display: grid; grid-template-columns: repeat(auto-fit, minmax(min(250px, 100%), 1fr)); gap: 28px">
{% for s in shown %}{% set ph = s.photo.url if s.photo is mapping else s.photo %}{% set role = [s.title, s.org]|select|join(', ') %}<article style="display: flex; flex-direction: column; gap: 6px; min-width: 0"><div style="aspect-ratio: 1 / 1; border-radius: 999px; background: {{ 'var(--accent)' if loop.index is odd else '#1B2A9E' }}; padding: 10px; box-sizing: border-box; margin-bottom: 8px">{% if ph %}<img src="{{ isrc(ph) }}"{% if s.photo is mapping and s.photo.srcset %} srcset="{{ s.photo.srcset }}" sizes="(min-width: 1240px) 254px, (min-width: 640px) 40vw, calc(50vw - 40px)"{% endif %} width="254" height="254" alt="{{ s.name }}" loading="lazy" decoding="async" style="display: block; width: 100%; aspect-ratio: 1 / 1; height: auto; border-radius: 999px; object-fit: cover">{% elif s.photo and s.photo.placeholder is defined %}<div style="width: 100%; aspect-ratio: 1 / 1; border-radius: 999px; background: repeating-linear-gradient(135deg, #D9DCF2 0 14px, #E6E8F7 14px 28px)"></div>{% else %}<div style="width: 100%; aspect-ratio: 1 / 1; border-radius: 999px; background: #E6E8F7; display: flex; align-items: center; justify-content: center; font-family: Unbounded, system-ui, sans-serif; font-weight: 900; font-size: 48px">{% for w in (s.name or '').split()[:2] %}{{ w[:1]|upper }}{% endfor %}</div>{% endif %}</div><h3 style="margin: 0; font-family: Unbounded, system-ui, sans-serif; font-weight: 700; font-size: 19px; overflow-wrap: break-word">{{ s.name }}</h3>{% if role %}<span style="font-size: 15px">{{ role }}</span>{% endif %}{% if s.talk %}<span style="font-weight: 700">“{{ s.talk }}”</span>{% endif %}</article>
{% endfor %}</div>
{% if names or others > 0 %}<p style="margin: 0; font-size: 20px; font-weight: 500; border: 2px dashed #1B2A9E; border-radius: 24px; padding: 22px 26px">{% if names and others > 0 %}+ {{ names|join(', ') }} and {{ n(others) }} more people who said yes to five nervous minutes on stage.{% elif names %}+ {{ (names[:-1]|join(', ') ~ ' and ' ~ names[-1]) if names|length > 1 else names[0] }}, who said yes to five nervous minutes on stage.{% else %}+ {{ n(others) }} more people who said yes to five nervous minutes on stage.{% endif %}</p>
{% endif %}</section>
{%- endif -%}
