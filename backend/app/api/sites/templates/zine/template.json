      "section": "photos"
    },
    {
      "key": "photos.3",
      "label": "Photo 3",
      "size": [
        262,
        262
      ],
      "section": "photos"
    },
    {
      "key": "photos.4",
      "label": "Photo 4",
      "size": [
        262,
