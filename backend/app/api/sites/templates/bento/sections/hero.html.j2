{%- import "macros.html.j2" as m with context -%}
{%- set so_list = (socials or [])|rejectattr("kind", "equalto", "website")|list -%}
{%- set web_href = m.web_href(club, socials) -%}
{%- set web_label = m.web_label(club, socials) -%}
{%- set keys = (nav or [])|map(attribute="key")|list -%}
{%- set cover = images["hero.cover"] or club.cover -%}
{%- set join_href = "#join" if "join" in keys else (links.join_url or links.follow_url) -%}
<!-- PROFILE BENTO -->
<section id="top" style="display: flex; flex-wrap: wrap; gap: 20px">
<div style="flex: 3 1 480px; background: #FFFFFF; border-radius: 32px; padding: clamp(24px, 4vw, 44px); box-sizing: border-box; display: flex; flex-direction: column; gap: 18px; justify-content: space-between">
<div style="display: flex; align-items: center; gap: 14px">
<div class="{{ 'ph ph-img' if club.logo_url }}" style="width: 72px; height: 72px; border-radius: 22px; background: var(--accent); color: #FFFFFF; display: flex; align-items: center; justify-content: center; font-family: 'Bricolage Grotesque', system-ui, sans-serif; font-weight: 700; font-size: 34px; flex: none">{{ m.logo(club, 72, 72) }}</div>
<div style="display: flex; flex-wrap: wrap; gap: 8px"><span style="padding: 6px 14px; border-radius: 999px; background: #CFF1E1; font-weight: 600; font-size: 14px">Community</span><span style="padding: 6px 14px; border-radius: 999px; background: #FFEFB0; font-weight: 600; font-size: 14px">Open to new members</span></div>
</div>
<h1 class="b-h1" style="margin: 0; font-family: 'Bricolage Grotesque', system-ui, sans-serif; font-weight: 700; font-size: clamp(40px, 6vw, 76px); line-height: 1; letter-spacing: -0.03em">{{ site.headline or club.name }}</h1>
{% if site.subline or club.tagline or subline %}<p style="margin: 0; font-size: 19px; color: #4A4664; max-width: 620px">{{ site.subline or club.tagline or subline }}</p>{% endif %}
{% if club.location_name or club.founded_year or web_href or so_list %}<div class="b-wrap" style="display: flex; flex-wrap: wrap; gap: 6px 20px; color: #5D5878; font-size: 15px">{% if club.location_name %}<span>{{ club.location_name }}</span>{% endif %}{% if club.founded_year %}<span>Founded {{ club.founded_year }}</span>{% endif %}{% if web_href %}<a href="{{ web_href }}" target="_top">{{ web_label }}</a>{% endif %}{% for so in so_list %}{% set label, href = so.label, so.href %}<a href="{{ href }}" target="_top">{{ label }}</a>{% endfor %}</div>{% endif %}
{% if join_href or links.follow_url %}<div style="display: flex; flex-wrap: wrap; gap: 10px">
{% if join_href %}<a href="{{ join_href }}" style="display: inline-flex; align-items: center; min-height: 50px; padding: 0 28px; border-radius: 999px; background: var(--accent); color: #FFFFFF; text-decoration: none; font-weight: 600">Join community</a>{% endif %}
{% if links.follow_url %}<a href="{{ links.follow_url }}" target="_top" class="btn-a" style="min-height: 50px; padding: 0 26px; border-radius: 999px; background: #F4EFFA; color: #23203A; border: none; font: 600 16px 'DM Sans', system-ui, sans-serif; cursor: pointer">Follow</a>{% endif %}
</div>{% endif %}
</div>
<div class="{{ m.phc(cover, 'b-cover') }}" style="flex: 2 1 320px; min-height: 380px; border-radius: 32px; background: repeating-linear-gradient(135deg, #DCD2FF 0 14px, #E7E0FF 14px 28px); display: flex; align-items: flex-end; padding: 18px; box-sizing: border-box">{% if m.real(cover) %}{{ m.fill(cover, 640, 480, "(max-width: 900px) 100vw, 500px", eager=true, alt=club.name) }}{% elif m.label(cover) %}<span style="background: #FFFFFF; font-size: 13px; padding: 6px 12px; border-radius: 999px">{{ m.label(cover) }}</span>{% endif %}</div>
</section>
