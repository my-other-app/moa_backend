{%- import "macros.html.j2" as m with context -%}
{#- The designer's e-mail form, as a link (see classic/sections/join.html.j2). -#}
{%- if links.join_url -%}
<section id="join" style="background: #23203A; color: #FFFFFF; border-radius: 32px; padding: clamp(28px, 5vw, 56px); display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 28px">
<div style="flex: 1 1 360px; display: flex; flex-direction: column; gap: 8px"><h2 style="margin: 0; font-family: 'Bricolage Grotesque', system-ui, sans-serif; font-weight: 700; font-size: clamp(32px, 4.6vw, 54px); line-height: 1.05">{{ section.title }}</h2><p style="margin: 0; color: #DAD6EE; font-size: 17px">Membership is free. Invitations first, every talk recorded, a seat at the table.</p></div>
<div style="flex: 1 1 340px; display: flex; flex-direction: column; gap: 8px">
<span style="font-size: 14px; font-weight: 600">Free to join</span>
<a href="{{ links.join_url }}" target="_top" class="j-row" style="display: flex; flex-wrap: wrap; gap: 10px; text-decoration: none"><span class="j-pill" style="flex: 1 1 200px; min-height: 52px; padding: 0 20px; border-radius: 999px; border: none; background: #FFFFFF; color: #23203A; font: 400 16px 'DM Sans', system-ui, sans-serif; box-sizing: border-box">Follow us on MyOtherApp →</span><span class="btn-a" style="min-height: 52px; padding: 0 28px; border-radius: 999px; border: none; background: #FFEFB0; color: #23203A; font: 600 16px 'DM Sans', system-ui, sans-serif; cursor: pointer">Join</span></a>
</div>
</section>
{%- endif -%}
