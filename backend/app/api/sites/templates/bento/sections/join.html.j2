{%- import "macros.html.j2" as m with context -%}
{#- The designer's e-mail form becomes its button alone, a link to join_url (the page can't post: CSP form-action 'none'); the form's column keeps its height. join_text replaces the designer's promise line. -#}
{%- set jt = join_text or "Joining is free. Follow us to hear about every event first." -%}
{%- if links.join_url -%}
<section id="join" style="background: #23203A; color: #FFFFFF; border-radius: 32px; padding: clamp(28px, 5vw, 56px); display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 28px">
<div style="flex: 1 1 360px; display: flex; flex-direction: column; gap: 8px"><h2 style="margin: 0; font-family: 'Bricolage Grotesque', system-ui, sans-serif; font-weight: 700; font-size: clamp(32px, 4.6vw, 54px); line-height: 1.05">{{ section.title }}</h2><p style="margin: 0; color: #DAD6EE; font-size: 17px">{{ jt }}</p></div>
<div class="j-col" style="flex: 1 1 340px; display: flex; flex-direction: column; justify-content: flex-end; gap: 8px; min-height: 81px">
<div class="j-cta" style="display: flex; flex-wrap: wrap; gap: 10px; justify-content: flex-end"><a href="{{ links.join_url }}" target="_top" class="btn-a" style="min-height: 52px; padding: 0 28px; border-radius: 999px; border: none; background: #FFEFB0; color: #23203A; font: 600 16px 'DM Sans', system-ui, sans-serif; cursor: pointer">Join</a></div>
</div>
</section>
{%- endif -%}
