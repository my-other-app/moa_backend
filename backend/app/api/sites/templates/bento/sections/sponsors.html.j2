{%- import "macros.html.j2" as m with context -%}
{%- set ns = namespace(b=[], p=[]) -%}
{%- for s in sponsors -%}{%- if "sponsor" in (s.role or "")|lower -%}{%- set ns.b = ns.b + [s] -%}{%- else -%}{%- set ns.p = ns.p + [s] -%}{%- endif -%}{%- endfor -%}
{%- set backers, partners = ns.b, ns.p -%}
{%- if sponsors -%}
<section id="sponsors" style="flex: 1 1 400px; background: #FFFFFF; border-radius: 32px; padding: 32px; box-sizing: border-box; display: flex; flex-direction: column; gap: 18px">
<h2 style="margin: 0; font-family: 'Bricolage Grotesque', system-ui, sans-serif; font-weight: 700; font-size: 28px">{{ section.title }}</h2>
<div class="b-2up-phone" style="display: grid; grid-template-columns: repeat(auto-fit, minmax(min(150px, 100%), 1fr)); gap: 12px">
{% for s in backers + partners %}{% set is_partner = loop.index > backers|length %}<div style="min-height: 84px; border-radius: 20px; {% if is_partner %}border: 1.5px dashed #8F89B3{% else %}background: #F4EFFA{% endif %}; display: flex; align-items: center; justify-content: center; font-size: 14px; color: #5D5878">{% if m.real(s.logo) %}<img class="logo-img" src="{{ s.logo.url }}"{% if s.logo.srcset %} srcset="{{ s.logo.srcset }}" sizes="130px"{% endif %} width="{{ s.logo.w or 130 }}" height="{{ s.logo.h or 52 }}" alt="{{ s.name }}" loading="lazy" decoding="async" style="max-width: 75%; max-height: 52px">{% else %}{{ s.name }}{% endif %}</div>
{% endfor %}</div>
{% if links.contact_mailto %}<a href="{{ links.contact_mailto }}" target="_top" style="font-weight: 600; padding: 10px 0">Become a sponsor →</a>{% endif %}
</section>
{%- endif -%}
