{%- import "_shared/macros.html.j2" as m with context -%}
{%- set stripes = [("#FFD9C7", "#FFE5D8"), ("#CFF1E1", "#DDF6EA"), ("#DCD2FF", "#E7E0FF"), ("#FFEFB0", "#FFF4C8")] -%}
{%- if past -%}
<section id="past" style="background: #FFFFFF; border-radius: 32px; padding: clamp(24px, 4vw, 40px); display: flex; flex-direction: column; gap: 24px">
<div style="display: flex; flex-wrap: wrap; align-items: baseline; justify-content: space-between; gap: 12px"><h2 style="margin: 0; font-family: 'Bricolage Grotesque', system-ui, sans-serif; font-weight: 700; font-size: 32px">{{ section.title }}</h2>{% if links.events_url %}<a href="{{ links.events_url }}" style="font-weight: 600; padding: 10px 0">See all {% if stats.events_held %}{{ m.num(stats.events_held) }} {% endif %}→</a>{% endif %}</div>
<div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(min(250px, 100%), 1fr)); gap: 20px">
{% for e in past %}{% set pic = e.poster or images["event.fallback"] %}{% set a, b = stripes[loop.index0 % 4] %}<article style="display: flex; flex-direction: column; gap: 10px"><div class="{{ m.phc(pic) }}" style="height: 160px; border-radius: 22px; background: repeating-linear-gradient(135deg, {{ a }} 0 14px, {{ b }} 14px 28px)">{% if m.real(pic) %}{{ m.fill(pic, 300, 160, "(max-width: 600px) 100vw, 300px", alt=e.name, poster=(pic is sameas e.poster)) }}{% endif %}</div><span style="font-size: 14px; font-weight: 600; color: #5D5878">{{ [e.day ~ " " ~ e.month ~ " " ~ e.year, e.kind]|select|join(" · ") }}</span><h3 style="margin: 0; font-weight: 600; font-size: 19px; line-height: 1.25">{{ e.name }}</h3>{% if e.facts %}<span style="font-size: 14px; color: #5D5878">{{ e.facts|join(" · ") }}</span>{% endif %}{% if e.url %}<a href="{{ e.url }}" style="font-weight: 600; padding: 8px 0">Recap →</a>{% endif %}</article>
{% endfor %}</div>
</section>
{%- endif -%}
