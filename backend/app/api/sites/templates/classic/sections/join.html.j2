{%- import "_shared/macros.html.j2" as m with context -%}
{%- if links.join_url -%}
<!-- JOIN CTA -->
<section id="join" class="c-pb c-flush" style="padding: 0 0 96px">
<div style="max-width: 1200px; margin: 0 auto; padding: 0 24px">
<div style="background: var(--accent); color: #FFFFFF; border-radius: 28px; padding: clamp(32px, 6vw, 72px); display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 32px">
<div style="flex: 1 1 420px; display: flex; flex-direction: column; gap: 12px">
<h2 style="margin: 0; font-family: 'Space Grotesk', system-ui, sans-serif; font-weight: 700; font-size: clamp(32px, 4.6vw, 56px); line-height: 1.05; letter-spacing: -0.02em">{{ section.title }}</h2>
<p style="margin: 0; font-size: 18px; color: #FFFFFF; max-width: 520px">Membership is free. You get event invitations first, recordings of every talk and a seat at the table.</p>
</div>
<form action="{{ links.join_url }}" method="get" target="_top" style="flex: 1 1 360px; display: flex; flex-direction: column; gap: 10px">
<label for="join-email" style="font-size: 14px; font-weight: 600">Email address</label>
<div style="display: flex; flex-wrap: wrap; gap: 10px">
<input id="join-email" name="email" type="email" autocomplete="email" placeholder="you@example.com" style="flex: 1 1 220px; min-height: 52px; padding: 0 18px; border-radius: 999px; border: none; font: 400 16px Inter, system-ui, sans-serif; color: #0D1220; background: #FFFFFF; box-sizing: border-box">
<button type="submit" style="min-height: 52px; padding: 0 28px; border-radius: 999px; border: none; background: #0D1220; color: #FFFFFF; font: 600 16px Inter, system-ui, sans-serif; cursor: pointer">Join community</button>
</div>
</form>
</div>
</div>
</section>
{%- endif -%}
