{%- import "macros.html.j2" as m with context -%}
{#- The designer's e-mail form becomes its button alone, a link to join_url (the page can't post: CSP form-action 'none'); the form's column keeps its height. join_text replaces the designer's promise line. -#}
{%- set jt = join_text or "Joining is free. Follow us to hear about every event first." -%}
{%- if links.join_url -%}
<!-- JOIN CTA -->
<section id="join" class="c-pb c-flush" style="padding: 0 0 96px">
<div style="max-width: 1200px; margin: 0 auto; padding: 0 24px">
<div style="background: var(--accent); color: #FFFFFF; border-radius: 28px; padding: clamp(32px, 6vw, 72px); display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 32px">
<div style="flex: 1 1 420px; display: flex; flex-direction: column; gap: 12px">
<h2 style="margin: 0; font-family: 'Space Grotesk', system-ui, sans-serif; font-weight: 700; font-size: clamp(32px, 4.6vw, 56px); line-height: 1.05; letter-spacing: -0.02em">{{ section.title }}</h2>
<p style="margin: 0; font-size: 18px; color: #FFFFFF; max-width: 520px">{{ jt }}</p>
</div>
<div class="j-col" style="flex: 1 1 360px; display: flex; flex-direction: column; justify-content: flex-end; gap: 10px; min-height: 83px">
<div class="j-cta" style="display: flex; flex-wrap: wrap; gap: 10px; justify-content: flex-end">
<a href="{{ links.join_url }}" target="_top" class="btn-a" style="min-height: 52px; padding: 0 28px; border-radius: 999px; border: none; background: #0D1220; color: #FFFFFF; font: 600 16px Inter, system-ui, sans-serif; cursor: pointer">Join community</a>
</div>
</div>
</div>
</div>
</section>
{%- endif -%}
