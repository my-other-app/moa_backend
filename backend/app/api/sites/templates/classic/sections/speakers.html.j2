{%- import "macros.html.j2" as m with context -%}
{%- if speakers -%}
<!-- SPEAKERS -->
<section id="speakers" style="padding: 96px 0; background: #0D1220; color: #FFFFFF">
<div style="max-width: 1200px; margin: 0 auto; padding: 0 24px; display: flex; flex-direction: column; gap: 32px">
<div style="display: flex; flex-wrap: wrap; align-items: flex-end; justify-content: space-between; gap: 16px">
<div style="display: flex; flex-direction: column; gap: 8px">
<div style="font-size: 13px; font-weight: 600; letter-spacing: 0.08em; text-transform: uppercase; color: #B4BCD0">Everyone who has taken our stage</div>
<h2 style="margin: 0; font-family: 'Space Grotesk', system-ui, sans-serif; font-weight: 700; font-size: clamp(30px, 4vw, 44px); line-height: 1.1; letter-spacing: -0.02em">{{ section.title }}</h2>
</div>
{% if links.contact_mailto %}<a href="{{ links.contact_mailto }}" target="_top" style="display: inline-flex; align-items: center; min-height: 44px; padding: 0 22px; border-radius: 999px; border: 1.5px solid #FFFFFF; color: #FFFFFF; text-decoration: none; font-weight: 600; font-size: 15px">Apply to speak</a>{% endif %}
</div>
<div class="c-2up-phone" style="display: grid; grid-template-columns: repeat(auto-fit, minmax(min(250px, 100%), 1fr)); gap: 24px">
{% for s in speakers[:4] %}<article style="display: flex; flex-direction: column; gap: 16px">
<div class="{{ m.phc(s.photo, 'ph-dark') }}" style="aspect-ratio: 1 / 1; border-radius: 20px; background: repeating-linear-gradient(135deg, #1B2238 0 14px, #232B45 14px 28px); display: flex; align-items: flex-end; padding: 14px; box-sizing: border-box">{% if m.real(s.photo) %}{{ m.fill(s.photo, 280, 280, "(max-width: 600px) 100vw, 280px", alt=s.name) }}{% elif m.label(s.photo) %}<span style="background: #0D1220; color: #D5DBEA; font-size: 12px; font-weight: 500; padding: 4px 10px; border-radius: 6px">{{ m.label(s.photo) }}</span>{% else %}<span class="ph-ini" aria-hidden="true">{{ m.initials(s.name) }}</span>{% endif %}</div>
<div style="display: flex; flex-direction: column; gap: 4px">
<h3 style="margin: 0; font-family: 'Space Grotesk', system-ui, sans-serif; font-weight: 600; font-size: 21px">{{ s.name }}</h3>
{% if s.title or s.org %}<span style="font-size: 14px; color: #B4BCD0">{{ m.role(s) }}</span>{% endif %}
{% if s.talk or s.event %}<span style="font-size: 15px; color: #FFFFFF; margin-top: 6px">{{ [s.talk, s.event]|select|join(" · ") }}</span>{% endif %}
</div>
</article>
{% endfor %}</div>
{% if speakers[4:] %}
<div style="display: flex; flex-direction: column; gap: 20px; margin-top: 40px; padding-top: 40px; border-top: 1px solid #2A3147">
<div style="display: flex; flex-wrap: wrap; align-items: baseline; justify-content: space-between; gap: 16px">
<h3 style="margin: 0; font-family: 'Space Grotesk', system-ui, sans-serif; font-weight: 600; font-size: 26px">More past speakers</h3>
{% if links.speakers_url and stats.speakers %}<a href="{{ links.speakers_url }}" target="_top" style="font-weight: 600; font-size: 15px; color: #FFFFFF; padding: 12px 0">See all {{ m.num(stats.speakers) }} →</a>{% endif %}
</div>
<div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(min(340px, 100%), 1fr)); gap: 0 32px">
{% for s in speakers[4:] %}<div style="display: flex; align-items: center; gap: 16px; padding: 16px 0; border-bottom: 1px solid #2A3147">
<span class="{{ 'ph ph-img' if m.real(s.photo) }}" style="width: 48px; height: 48px; border-radius: 999px; background: #232B45; color: #FFFFFF; display: flex; align-items: center; justify-content: center; font-weight: 600; font-size: 15px; flex: none">{% if m.real(s.photo) %}{{ m.fill(s.photo, 48, 48, "48px", alt=s.name) }}{% else %}{{ m.initials(s.name) }}{% endif %}</span>
<div style="display: flex; flex-direction: column; min-width: 0"><span style="font-weight: 600">{{ s.name }}</span>{% if s.title or s.event %}<span style="font-size: 14px; color: #B4BCD0">{{ [s.title, s.event]|select|join(" · ") }}</span>{% endif %}</div>
</div>
{% endfor %}</div>
</div>
{% endif %}
</div>
</section>
{%- endif -%}
