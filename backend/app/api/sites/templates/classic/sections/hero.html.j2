{%- import "_shared/macros.html.j2" as m with context -%}
{%- set cover = images["hero.cover"] or club.cover -%}
{%- set join_href = "#join" if "join" in section_keys else (links.join_url or links.follow_url) -%}
{%- set people = stats.members if stats.members is not none else stats.followers -%}
{%- set tiles = [(people, "Members" if stats.members is not none else "Followers"), (stats.events_held, "Events hosted"), (stats.speakers, "Speakers on stage"), (stats.sponsors, "Sponsors and partners")]|selectattr(0)|list -%}
<!-- PROFILE HERO -->
<section id="top" style="background: #FFFFFF">
<div class="{{ m.phc(cover, 'c-cover') }}" style="min-height: 300px; background: repeating-linear-gradient(135deg, #DCE1EA 0 14px, #E7EBF1 14px 28px); display: flex; align-items: flex-end; justify-content: flex-end; padding: 20px 24px; box-sizing: border-box">
{% if m.real(cover) %}{{ m.fill(cover, 1440, 300, "100vw", eager=true, alt=club.name) }}{% elif m.label(cover) %}<span style="background: #FFFFFF; color: #3D4558; font-size: 13px; font-weight: 500; padding: 6px 12px; border-radius: 6px">{{ m.label(cover) }}</span>{% endif %}
</div>
<div style="max-width: 1200px; margin: 0 auto; padding: 0 24px 64px; display: flex; flex-direction: column; gap: 32px">
<div style="display: flex; flex-wrap: wrap; align-items: flex-end; justify-content: space-between; gap: 24px; margin-top: -56px">
<div class="{{ 'ph ph-img' if club.logo_url }}" style="width: 128px; height: 128px; border-radius: 24px; background: var(--accent); border: 6px solid #FFFFFF; box-sizing: border-box; display: flex; align-items: center; justify-content: center; color: #FFFFFF; font-family: 'Space Grotesk', system-ui, sans-serif; font-weight: 700; font-size: 52px">{{ m.logo(club, 116, 116) }}</div>
<div style="display: flex; flex-wrap: wrap; gap: 12px">
{% if join_href %}<a href="{{ join_href }}" style="display: inline-flex; align-items: center; min-height: 48px; padding: 0 26px; border-radius: 999px; background: var(--accent); color: #FFFFFF; text-decoration: none; font-weight: 600">Join community</a>{% endif %}
{% if links.follow_url %}<a href="{{ links.follow_url }}" class="btn-a" style="min-height: 48px; padding: 0 24px; border-radius: 999px; background: #FFFFFF; color: #0D1220; border: 1.5px solid #0D1220; font: 600 16px Inter, system-ui, sans-serif; cursor: pointer">Follow</a>{% endif %}
{% if links.share_url %}<a href="{{ links.share_url }}" class="btn-a" aria-label="Share profile" style="width: 48px; height: 48px; border-radius: 999px; background: #FFFFFF; color: #0D1220; border: 1.5px solid #D9DEE7; display: inline-flex; align-items: center; justify-content: center; cursor: pointer">
<svg aria-hidden="true" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 12v7a1 1 0 0 0 1 1h14a1 1 0 0 0 1-1v-7"></path><path d="M12 15V3"></path><path d="m7 8 5-5 5 5"></path></svg>
</a>{% endif %}
</div>
</div>
<div style="display: flex; flex-direction: column; gap: 16px; max-width: 820px">
<div style="display: flex; flex-wrap: wrap; gap: 8px">
<span style="font-size: 13px; font-weight: 600; letter-spacing: 0.06em; text-transform: uppercase; padding: 5px 12px; border-radius: 999px; background: #0D1220; color: #FFFFFF">Community</span>
<span style="font-size: 13px; font-weight: 600; letter-spacing: 0.06em; text-transform: uppercase; padding: 5px 12px; border-radius: 999px; background: #FFB25C; color: #0D1220">Open to new members</span>
</div>
<h1 class="c-h1" style="margin: 0; font-family: 'Space Grotesk', system-ui, sans-serif; font-weight: 700; font-size: clamp(40px, 6vw, 72px); line-height: 1.02; letter-spacing: -0.03em">{{ site.headline or club.name }}</h1>
{% if site.subline %}<p style="margin: 0; font-size: 20px; line-height: 1.5; color: #3D4558; text-wrap: pretty">{{ site.subline }}</p>{% endif %}
{% if club.location_name or club.founded_year or club.website %}<div style="display: flex; flex-wrap: wrap; gap: 8px 24px; color: #535B6E; font-size: 15px">
{% if club.location_name %}<span style="display: inline-flex; align-items: center; gap: 8px"><svg aria-hidden="true" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 21s7-6.2 7-11.5A7 7 0 0 0 5 9.5C5 14.8 12 21 12 21z"></path><circle cx="12" cy="9.5" r="2.5"></circle></svg>{{ club.location_name }}</span>{% endif %}
{% if club.founded_year %}<span style="display: inline-flex; align-items: center; gap: 8px"><svg aria-hidden="true" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="5" width="18" height="16" rx="2"></rect><path d="M3 10h18M8 3v4M16 3v4"></path></svg>Founded {{ club.founded_year }}</span>{% endif %}
{% if club.website %}<span style="display: inline-flex; align-items: center; gap: 8px"><svg aria-hidden="true" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9"></circle><path d="M3 12h18M12 3a14 14 0 0 1 0 18M12 3a14 14 0 0 0 0 18"></path></svg><a href="{{ club.website.href }}" class="c-wrap" style="color: #535B6E">{{ club.website.label }}</a></span>{% endif %}
</div>{% endif %}
</div>
{% if tiles %}<div class="c-2up c-stats" style="display: grid; grid-template-columns: repeat(auto-fit, minmax(min(200px, 100%), 1fr)); gap: 0; border: 1px solid #D9DEE7; border-radius: 16px; overflow: hidden">
{% for value, label in tiles %}<div style="padding: 24px 28px; border-right: 1px solid #D9DEE7; border-bottom: 1px solid #D9DEE7; margin: 0 -1px -1px 0">
<div style="font-family: 'Space Grotesk', system-ui, sans-serif; font-weight: 700; font-size: 36px; line-height: 1.1">{{ m.num(value) }}</div>
<div style="color: #535B6E; font-size: 15px">{{ label }}</div>
</div>
{% endfor %}</div>{% endif %}
</div>
</section>
