{
  "key": "classic",
  "name": "Classic",
  "blurb": "Profile page with a cover, stats, events, speakers and team",
  "fonts": ["Inter:wght@400;500;600", "Space+Grotesk:wght@500;600;700"],
  "layout": "single",
  "fixed_top": ["nav", "hero"],
  "fixed_side": [],
  "fixed_bottom": ["footer"],
  "sections": [
    {"key": "about", "label": "About and expertise", "default_title": "About us", "hideable": true},
    {"key": "upcoming", "label": "Upcoming events", "default_title": "Upcoming events", "hideable": true, "anchor": "events"},
    {"key": "past", "label": "Past events", "default_title": "Past events", "hideable": true},
    {"key": "photos", "label": "Photos", "default_title": "Highlights", "hideable": true},
    {"key": "speakers", "label": "Speakers", "default_title": "Previous speakers", "hideable": true},
    {"key": "team", "label": "Team", "default_title": "The team", "hideable": true},
    {"key": "sponsors", "label": "Sponsors and partners", "default_title": "Sponsors and partners", "hideable": true, "anchor": "partners"},
    {"key": "join", "label": "Join banner", "default_title": "Come to the next one.", "hideable": true}
  ],
  "slots": [
    {"key": "hero.cover", "label": "Cover photo", "size": [1440, 300], "section": "hero"},
    {"key": "photos.1", "label": "Featured photo", "size": [720, 440], "section": "photos"},
    {"key": "photos.2", "label": "Photo 2", "size": [400, 212], "section": "photos"},
    {"key": "photos.3", "label": "Photo 3", "size": [400, 212], "section": "photos"},
    {"key": "photos.4", "label": "Photo 4", "size": [400, 212], "section": "photos"},
    {"key": "event.fallback", "label": "Event banner (events without a poster)", "size": [600, 340], "section": "upcoming"}
  ],
  "accent": {"default": "#2B4BFF", "vars": ["--accent"]}
}
