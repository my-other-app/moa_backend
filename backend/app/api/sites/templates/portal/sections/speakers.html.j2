{%- macro isrc(h) -%}{%- set l = (h or '')|string|trim -%}{{ l if (l[:8]|lower == 'https://' or l[:7]|lower == 'file://' or l[:11]|lower == 'data:image/') else '' }}{%- endmacro -%}
{%- macro u(h) -%}{%- set l = (h or '')|string|trim -%}{{ l if (l[:8]|lower == 'https://' or l[:7]|lower == 'mailto:' or l[:4]|lower == 'tel:' or l[:1] == '#') else '#' }}{%- endmacro -%}
{%- macro n(v) -%}{%- if v is number -%}{{ ('[' ~ '{:,}'.format(v) ~ ']') if sample else '{:,}'.format(v) }}{%- else -%}{{ v }}{%- endif -%}{%- endmacro -%}
{%- macro iso(v) -%}{{ (v if v is string else v.isoformat()) if v else '' }}{%- endmacro -%}
{%- set t = section.title if (section is defined and section.title) else 'Previous speakers' -%}
{%- set cnt = (speakers or [])|length -%}
{%- set flat = cnt - (2 if cnt % 2 == 0 else 1) -%}
{%- if speakers -%}
<section id="speakers" class="pt-card" style="background: #FFFFFF; border: 1px solid #D5D9DE; border-radius: 16px; padding: 22px; display: flex; flex-direction: column; gap: 4px">
<div style="display: flex; align-items: center; justify-content: space-between; gap: 12px; margin-bottom: 4px"><h2 style="margin: 0; font-weight: 700; font-size: 18px">{{ t }}{% if stats.speakers %} <span style="color: #565D66; font-weight: 500">{{ n(stats.speakers) }}</span>{% endif %}</h2>{% if links.speakers_url %}<a href="{{ u(links.speakers_url) }}" target="_top" style="font-weight: 600; padding: 10px 0">See all</a>{% endif %}</div>
<div class="pt-spk" style="display: grid; grid-template-columns: repeat(auto-fit, minmax(min(300px, 100%), 1fr)); gap: 0 24px">
{% for s in speakers %}{% set ph = s.photo.url if s.photo is mapping else s.photo %}{% set role = [s.title, s.org]|select|join(', ') %}{% set line = [s.talk, s.event]|select|join(' · ') %}<article style="display: flex; align-items: center; gap: 12px; padding: 12px 0{% if loop.index0 < flat %}; border-bottom: 1px solid #E4E7EA{% endif %}">{% if ph %}<img src="{{ isrc(ph) }}"{% if s.photo is mapping and s.photo.srcset %} srcset="{{ s.photo.srcset }}" sizes="52px"{% endif %} width="52" height="52" alt="{{ s.name }}" loading="lazy" decoding="async" style="width: 52px; height: 52px; border-radius: 999px; object-fit: cover; flex: none">{% elif s.photo and s.photo.placeholder is defined %}<span style="width: 52px; height: 52px; border-radius: 999px; background: #DDE1E6; flex: none"></span>{% else %}<span style="width: 52px; height: 52px; border-radius: 999px; background: #DDE1E6; flex: none; display: flex; align-items: center; justify-content: center; font-weight: 700; font-size: 16px; color: #3B4149">{% for w in (s.name or '').split()[:2] %}{{ w[:1]|upper }}{% endfor %}</span>{% endif %}<div style="min-width: 0"><h3 style="margin: 0; font-weight: 600; font-size: 15px">{{ s.name }}{% if role %} <span style="font-weight: 400; color: #565D66">· {{ role }}</span>{% endif %}</h3>{% if line %}<span style="font-size: 14px; color: #3B4149">{{ line }}</span>{% endif %}</div></article>
{% endfor %}</div>
</section>
{%- endif -%}
