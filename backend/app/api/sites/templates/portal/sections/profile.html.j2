{%- macro isrc(h) -%}{%- set l = (h or '')|string|trim -%}{{ l if (l[:8]|lower == 'https://' or l[:7]|lower == 'file://' or l[:11]|lower == 'data:image/') else '' }}{%- endmacro -%}
{%- macro u(h) -%}{%- set l = (h or '')|string|trim -%}{{ l if (l[:8]|lower == 'https://' or l[:7]|lower == 'mailto:' or l[:4]|lower == 'tel:' or l[:1] == '#') else '#' }}{%- endmacro -%}
{%- macro n(v) -%}{%- if v is number -%}{{ ('[' ~ '{:,}'.format(v) ~ ']') if sample else '{:,}'.format(v) }}{%- else -%}{{ v }}{%- endif -%}{%- endmacro -%}
{%- macro host(h, label) -%}{%- set l = (h or '')|string -%}{{ (l.split('//')[1].split('/')[0]|replace('www.', '')) if l[:8]|lower == 'https://' else (label or l) }}{%- endmacro -%}
{%- set jt = join_text or "Joining is free. Follow us to hear about every event first." -%}
{%- set keys = (nav|map(attribute='key')|list) if (nav is defined and nav) else (section_keys or []) -%}
{%- set overrides = site.title_overrides or {} -%}
{%- set cover = images['hero.cover'] -%}
{%- set logo = club.logo if (club.logo and club.logo.url) else ({'url': club.logo_url, 'srcset': club.logo_srcset} if club.logo_url else none) -%}
{%- set lead = site.subline or club.tagline or subline -%}
{%- set platform_url = links.platform_url or 'https://myotherapp.in' -%}
{%- set soc = [] -%}{%- set web = [] -%}
{%- for s in socials or [] -%}{%- set item = {'kind': (s.kind if s is mapping else (s[0]|lower)), 'label': (s.label if s is mapping else s[0]), 'href': (s.href if s is mapping else s[1])} -%}{%- set _ = (web if item.kind == 'website' else soc).append(item) -%}{%- endfor -%}
{%- if club.website and club.website.href -%}{%- set _ = web.insert(0, {'kind': 'website', 'label': club.website.label, 'href': club.website.href}) -%}{%- endif -%}
{%- set has_members = stats.members is defined and stats.members is not none -%}
{%- set people = stats.members if has_members else stats.followers -%}
{%- set nums = [(people, 'Members' if has_members else 'Followers'), (stats.events_held, 'Events hosted'), (stats.speakers, 'Speakers'), (stats.sponsors, 'Sponsors, partners')]|selectattr(0)|list -%}
{%- set topics = [] -%}{%- for x in club.topics or [] -%}{%- set _ = topics.append(x.name if x is mapping else x) -%}{%- endfor -%}
{%- set main_sp = [] -%}{%- set partners = [] -%}
{%- for p in sponsors or [] -%}{%- set _ = (main_sp if ((p.kind == 'sponsor') if p.kind else ('sponsor' in (p.role or '')|lower)) else partners).append(p) -%}{%- endfor -%}
{%- set events_total = (stats.events_held + (stats.upcoming or 0)) if (stats.events_held is number and (stats.upcoming is number or not stats.upcoming)) else stats.events_held -%}
{%- set events_key = 'upcoming' if 'upcoming' in keys else ('past' if 'past' in keys else none) -%}
{% if nums or topics or team or main_sp or partners or links.join_url %}<aside class="pt-rail" style="flex: 1 1 300px; min-width: 0; max-width: 420px; display: flex; flex-direction: column; gap: 20px">
{% if nums %}
<section id="stats" style="background: #FFFFFF; border: 1px solid #D5D9DE; border-radius: 16px; padding: 20px; display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 16px">
{% for v, label in nums %}<div><div style="font-weight: 700; font-size: 24px; letter-spacing: -0.02em">{{ n(v) }}</div><div style="color: #565D66; font-size: 13px">{{ label }}</div></div>
{% endfor %}</section>
{% endif %}{% if topics %}
<section id="expertise" style="background: #FFFFFF; border: 1px solid #D5D9DE; border-radius: 16px; padding: 20px; display: flex; flex-direction: column; gap: 12px">
<h2 style="margin: 0; font-weight: 700; font-size: 16px">Domains of expertise</h2>
<div style="display: flex; flex-wrap: wrap; gap: 8px; font-size: 14px; font-weight: 600">
{% for x in topics %}{% if loop.index <= 3 %}<span style="padding: 6px 12px; border-radius: 8px; background: var(--accent-soft); color: var(--accent-deep)">{{ x }}</span>{% else %}<span style="padding: 6px 12px; border-radius: 8px; background: #EEF0F2">{{ x }}</span>{% endif %}{% endfor %}
</div>
</section>
{% endif %}{% if team %}
<section id="team" style="background: #FFFFFF; border: 1px solid #D5D9DE; border-radius: 16px; padding: 20px; display: flex; flex-direction: column; gap: 12px">
<h2 style="margin: 0; font-weight: 700; font-size: 16px">{{ overrides.team or 'Team members' }} <span style="color: #565D66; font-weight: 500">{{ team|length }}</span></h2>
{% for m in team %}{% set ph = m.photo.url if m.photo is mapping else m.photo %}{% set ss = m.photo.srcset if m.photo is mapping else m.photo_srcset %}<div style="display: flex; align-items: center; gap: 12px">{% if ph %}<img src="{{ isrc(ph) }}"{% if ss %} srcset="{{ ss }}" sizes="40px"{% endif %} width="40" height="40" alt="{{ m.name }}" loading="lazy" decoding="async" style="width: 40px; height: 40px; border-radius: 999px; object-fit: cover; flex: none">{% elif m.photo and m.photo.placeholder is defined %}<span style="width: 40px; height: 40px; border-radius: 999px; background: #DDE1E6; flex: none"></span>{% else %}<span style="width: 40px; height: 40px; border-radius: 999px; background: #DDE1E6; flex: none; display: flex; align-items: center; justify-content: center; font-weight: 700; font-size: 13px; color: #3B4149">{% for w in (m.name or '').split()[:2] %}{{ w[:1]|upper }}{% endfor %}</span>{% endif %}<div style="line-height: 1.3; min-width: 0"><div style="font-weight: 600">{{ m.name }}</div>{% if m.role %}<div style="font-size: 13px; color: #565D66">{{ m.role }}</div>{% endif %}</div></div>
{% endfor %}</section>
{% endif %}{% if main_sp or partners %}
<section id="sponsors" style="background: #FFFFFF; border: 1px solid #D5D9DE; border-radius: 16px; padding: 20px; display: flex; flex-direction: column; gap: 12px">
{% if main_sp %}<h2 style="margin: 0; font-weight: 700; font-size: 16px">{{ overrides.sponsors or 'Sponsors' }}</h2>
<div style="display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 8px">
{% for p in main_sp %}{% set lg = p.logo.url if p.logo is mapping else p.logo %}<div style="min-height: 64px; border-radius: 10px; background: #F6F7F8; border: 1px solid #E4E7EA; display: flex; align-items: center; justify-content: center; font-size: 13px; color: #565D66; text-align: center; padding: 0 6px">{% if lg %}<img class="pt-logo" src="{{ isrc(lg) }}" width="140" height="44" alt="{{ p.name }}" loading="lazy" decoding="async">{% else %}{{ p.name }}{% endif %}</div>
{% endfor %}</div>
{% endif %}{% if partners %}<h2 style="margin: {{ '8px 0 0' if main_sp else '0' }}; font-weight: 700; font-size: 16px">Partners</h2>
<div style="display: flex; flex-direction: column; font-size: 14px">
{% for p in partners %}<div style="display: flex; justify-content: space-between; gap: 12px; padding: 8px 0{% if not loop.last %}; border-bottom: 1px solid #E4E7EA{% endif %}"><span style="font-weight: 600">{{ p.name }}</span>{% if p.role %}<span style="color: #565D66; text-align: right">{{ p.role }}</span>{% endif %}</div>
{% endfor %}</div>
{% endif %}</section>
{% endif %}{% if links.join_url %}
<section id="join" style="background: #1A1D21; color: #FFFFFF; border-radius: 16px; padding: 20px; display: flex; flex-direction: column; gap: 10px">
<h2 style="margin: 0; font-weight: 700; font-size: 20px; line-height: 1.2">{{ overrides.join or 'Come to the next one.' }}</h2>
<p style="margin: 0; color: #D5D9DE; font-size: 14px">{{ jt }}</p>
<div class="pt-joinbox" style="display: flex; flex-direction: column; justify-content: flex-end; gap: 8px; min-height: 123.5px"><a class="pt-btn" href="{{ u(links.join_url) }}" target="_top" style="min-height: 44px; border-radius: 10px; border: none; background: var(--accent); color: var(--on-accent); font: 700 15px 'Plus Jakarta Sans', system-ui, sans-serif; cursor: pointer; text-decoration: none">Join community</a></div>
</section>
{% endif %}</aside>{% endif %}
