{
  "page": {
    "width_px": 1123,
    "height_px": 794,
    "paper": "A4 landscape",
    "token_syntax": "{{token_name}}"
  },
  "common_fields": [
    "accent_color",
    "certificate_id",
    "institute_name",
    "qr_code_src",
    "recipient_name",
    "signatory_designation",
    "signatory_name"
  ],
  "fields": {
    "accent_color": {
      "description": "Hex accent colour, e.g. #6B1F2E. Replace every occurrence",
      "type": "color"
    },
    "certificate_id": {
      "description": "Unique certificate number; also encoded in the QR URL",
      "type": "text"
    },
    "completion_date": {
      "description": "Date the course was completed, pre-formatted",
      "type": "text"
    },
    "course_title": {
      "description": "Course or programme name",
      "type": "text"
    },
    "duration_hours": {
      "description": "Course length in hours, number only",
      "type": "text"
    },
    "end_date": {
      "description": "Course end date, pre-formatted",
      "type": "text"
    },
    "event_date": {
      "description": "Event date, pre-formatted",
      "type": "text"
    },
    "event_title": {
      "description": "Event or workshop name",
      "type": "text"
    },
    "expiry_date": {
      "description": "Date the credential expires, pre-formatted",
      "type": "text"
    },
    "grade": {
      "description": "Grade or score achieved",
      "type": "text"
    },
    "institute_name": {
      "description": "Name of the issuing organisation (pass normal casing)",
      "type": "text"
    },
    "issue_city": {
      "description": "City of issue",
      "type": "text"
    },
    "issue_date": {
      "description": "Date the certificate was issued, pre-formatted",
      "type": "text"
    },
    "issue_year": {
      "description": "Four-digit year of issue",
      "type": "text"
    },
    "logo_src": {
      "description": "Image src for the institute logo: data URI or reachable URL",
      "type": "image_src"
    },
    "qr_code_src": {
      "description": "Image src for the QR code: data URI (SVG preferred) or reachable URL. Generate with no quiet zone, error correction M or higher",
      "type": "image_src"
    },
    "rank_or_grade": {
      "description": "Rank or grade achieved, e.g. First Rank",
      "type": "text"
    },
    "recipient_name": {
      "description": "Full name of the certificate recipient",
      "type": "text"
    },
    "second_signatory_designation": {
      "description": "Job title of the second signing authority",
      "type": "text"
    },
    "second_signatory_name": {
      "description": "Name of the second signing authority",
      "type": "text"
    },
    "signatory_designation": {
      "description": "Job title of the signing authority",
      "type": "text"
    },
    "signatory_name": {
      "description": "Name of the signing authority",
      "type": "text"
    },
    "start_date": {
      "description": "Course start date, pre-formatted",
      "type": "text"
    },
    "verify_url": {
      "description": "Public verification URL for this certificate; same value the QR encodes",
      "type": "text"
    }
  },
