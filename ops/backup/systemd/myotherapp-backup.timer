# Every day at 03:00 India time (21:30 UTC the day before). Persistent: a
# run missed while the box was off happens when it comes back. The zone is
# in OnCalendar itself, so the box's own timezone does not matter.
[Unit]
Description=MyOtherApp daily database backup at 03:00 IST

[Timer]
OnCalendar=*-*-* 03:00:00 Asia/Kolkata
Persistent=true
AccuracySec=1min
Unit=myotherapp-backup.service

[Install]
WantedBy=timers.target
