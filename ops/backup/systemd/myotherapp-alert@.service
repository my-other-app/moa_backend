# Runs when a backup unit fails (its OnFailure=): ops/backup/alert.sh tells
# the admins -- through the app (mail to APP_ADMIN_ALERT_EMAILS, Discord,
# the dashboard's bell), or straight to the Discord webhook in .env when the
# app is down. %i is the failed unit.
[Unit]
Description=MyOtherApp: tell the admins that %i failed

[Service]
Type=oneshot
Environment=MOA_PROJECT_DIR=/var/www/myotherapp-production
EnvironmentFile=-/etc/default/myotherapp-backup
ExecStart=/bin/bash ${MOA_PROJECT_DIR}/ops/backup/alert.sh %i
TimeoutStartSec=5min
