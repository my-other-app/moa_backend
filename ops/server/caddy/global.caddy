# Global options, imported first by Caddyfile and Caddyfile.staging (an
# import of a file is a plain paste of its text, so this is still the
# Caddyfile's first block).
{
	# 80 and 443 on the server. The MOA_*_PORT variables exist only so the
	# same files can be tried on a laptop (ops/server/README.md, "Testing").
	http_port {$MOA_HTTP_PORT:80}
	https_port {$MOA_HTTPS_PORT:443}

	# The proxied names use the Cloudflare Origin CA certificate
	# (snippets.caddy, origin_tls), which has no OCSP responder to staple.
	ocsp_stapling off

	servers {
		# Cloudflare's published ranges (https://www.cloudflare.com/ips/;
		# ops/server/cloudflare-ips.sh checks this list against them). A
		# request from one of them names its visitor in CF-Connecting-IP,
		# which becomes {client_ip}. From anywhere else {client_ip} is the
		# connection's own address, so nobody reaching the origin directly can
		# claim to be someone else. MOA_EXTRA_TRUSTED_PROXIES is for tests
		# only: never set it on a server.
		trusted_proxies static 173.245.48.0/20 103.21.244.0/22 103.22.200.0/22 103.31.4.0/22 141.101.64.0/18 108.162.192.0/18 190.93.240.0/20 188.114.96.0/20 197.234.240.0/22 198.41.128.0/17 162.158.0.0/15 104.16.0.0/13 104.24.0.0/14 172.64.0.0/13 131.0.72.0/22 2400:cb00::/32 2606:4700::/32 2803:f800::/32 2405:b500::/32 2405:8100::/32 2a06:98c0::/29 2c0f:f248::/32 {$MOA_EXTRA_TRUSTED_PROXIES}
		client_ip_headers CF-Connecting-IP

		# Cloudflare talks to the origin over HTTP/1.1 and HTTP/2 only, so no
		# QUIC listener (and no UDP port to open).
		protocols h1 h2
	}
}
