# /srv/moa/env/website.env: the public site's run-time settings (repo
# moa_events). Copy the values from the Vercel project moa-events
# (Settings -> Environment Variables -> Production), by hand, on the server.
# Mode 600, root. Applied with: sudo /srv/moa/deploy.sh recreate website
#
# Not here, on purpose:
#   - API_BASE_URL: compose.yml sets it to http://backend:8000 (the API over
#     the box's own network).
#   - NEXT_PUBLIC_*: written into the image when CI builds it
#     (moa_events: deploy/build/<environment>.env); setting one here changes
#     nothing in the browser.

# The API's POST /api/revalidate secret (the backend's APP_SITE_REVALIDATE_SECRET).
REVALIDATE_SECRET=

# Sent to the API as X-Site-Token on every server read (one of the backend's
# APP_SITE_TOKENS). Needed for /verify and for placing visitors.
API_SITE_TOKEN=

# Demo clubs kept out of search engines (moa_events README, "Demo clubs").
# Also read while pages are prerendered, so keep it the same in
# deploy/build/<environment>.env.
# DEMO_NOINDEX=off
# DEMO_CLUB_SLUGS=
