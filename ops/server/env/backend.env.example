# The lines to ADD to the API's .env when it moves to the Oracle box.
#
# /srv/moa/.env is the old box's file (/var/www/myotherapp-production/.env),
# copied over by hand and edited there: never synced from GitHub
# (PROD_ENV_VARIABLES is stale and replaces the whole file). Everything in the
# old file stays as it is; compose.yml sets these itself, whatever .env says:
#   APP_DATABASE_URL, APP_DATABASE_URL_SYNC  (built from POSTGRES_*)
#   APP_PORT=8000, WALLET_CERTS_DIR=/secrets/walletethings
#   APP_WORKERS (MOA_API_WORKERS, default 2), APP_RENDER_THREADS (MOA_RENDER_THREADS, default 1)
# and these by default unless .env sets them:
#   APP_REDIS_URL=redis://redis:6379/0, APP_SEARCH_URL=http://meilisearch:7700,
#   APP_SEARCH_KEY=<MEILI_MASTER_KEY>, APP_JOBS_WORKER=true, APP_SWEEPS_IN_WORKER=true,
#   FORWARDED_ALLOW_IPS=*
#
# Remove any APP_JOBS_WORKER=false or APP_SWEEPS_IN_WORKER=false carried over
# from the old box: here the worker runs the jobs and the sweeps (with false,
# the API would run them itself, and a rehearsal on a copy of production would
# send real mails). deploy.sh doctor warns about it.
#
# Names only below; generate values on the server, never paste them anywhere.

# Meilisearch's master key, 16+ bytes: openssl rand -hex 24
MEILI_MASTER_KEY=

# The API tells the site a page changed over the box's own network rather
# than out through Cloudflare (same secret as before).
APP_SITE_REVALIDATE_URL=http://website:3000/api/revalidate

# Only if the old .env used a Firebase JSON file: copy it to
# /srv/moa/secrets/service-account.json and point here (the image has no
# /backend/service-account.json). APP_FIREBASE_SERVICE_ACCOUNT_BASE64 needs
# nothing.
# APP_FIREBASE_SERVICE_ACCOUNT_PATH=/secrets/service-account.json

# GeoLite2, if the old box had it (copy the .mmdb to /var/lib/myotherapp/geoip).
# APP_GEOIP_MMDB_PATH=/geoip/GeoLite2-City.mmdb

# Off-site backups (ops/backup, docs/OPERATIONS.md section 4): AWS S3 in
# ap-south-1 with a backup-only IAM user.
# APP_BACKUP_S3_BUCKET=
# APP_BACKUP_S3_REGION=ap-south-1
# APP_BACKUP_S3_ACCESS_KEY=
# APP_BACKUP_S3_SECRET_KEY=
# APP_BACKUP_KEEP_LOCAL=7

# Optional knobs of this stack (compose.yml):
# MOA_API_WORKERS=2
# MOA_RENDER_THREADS=1

# ─── Staging box only ─────────────────────────────────────────────────────────
# MOA_CADDYFILE=Caddyfile.staging
# MOA_SITE_HOST=staging.myotherapp.in
# MOA_API_HOST=api-staging.myotherapp.in
# MOA_CLUBS_HOST=club-dashboard-staging.myotherapp.in
# MOA_ADMIN_HOST=main-portal-staging.myotherapp.in
# APP_ENV=staging
# APP_SENTRY_ENVIRONMENT=staging
# APP_PUBLIC_SITE_URL=https://staging.myotherapp.in
# APP_PUBLIC_WEB_URL=https://club-dashboard-staging.myotherapp.in
# APP_CORS_ORIGINS=["https://staging.myotherapp.in","https://club-dashboard-staging.myotherapp.in","https://main-portal-staging.myotherapp.in"]
# Razorpay TEST keys (rzp_test_...), its own webhook secret, a test SES/Resend
# sender, its own POSTGRES_PASSWORD and APP_SECRET_KEY: nothing shared with
# production.
