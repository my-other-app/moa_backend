# /srv/moa/env/ops-bot.env -- the Telegram ops bot's settings (ops/server/ops-bot).
# root:root, mode 600. Never in git. install.sh creates it from this file.
# After editing: sudo systemctl restart moa-ops-bot
#
# Only this file is read for the bot's settings; it never reads .env or
# any other env file.

# From @BotFather (/newbot). Digits, a colon, ~35 letters.
TELEGRAM_BOT_TOKEN=
# The owner's chat id: the only chat the bot answers and writes to. Send the
# new bot any message, then open
#   https://api.telegram.org/bot<token>/getUpdates
# in a browser and copy "chat":{"id": ...}. (Or ask @userinfobot.)
TELEGRAM_CHAT_ID=

# Who can decrypt the nightly backups: the owner's age public key. Its
# private half (backup-age.key) is never on this server.
OPS_AGE_RECIPIENT=age17jsckeq68nf0yrz7sgtrrk7y6930uykd3t4je4t9tmnk8jqrwagqmmwu9v

# Optional (defaults shown).
#OPS_HOST_LABEL=<hostname>                # the name in every message
#OPS_WATCH_INTERVAL=60                    # seconds between checks
#OPS_ERROR_MIN_LINES=3                    # error lines in one interval that start an alert
#OPS_ERROR_IGNORE_SERVICES=               # e.g. postgres,caddy: not scanned for errors
#OPS_MEM_LOW_PCT=10                       # alert under this % of memory available
#OPS_DISK_PATHS=/,/srv/moa-data,/var/backups/myotherapp
#OPS_BACKUP_DIR=/var/backups/myotherapp
#OPS_COMPOSE_PROJECT=moa
#OPS_DC=/srv/moa/dc
